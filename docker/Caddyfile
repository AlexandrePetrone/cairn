{
	# No skip_install_trust: Caddy adds its local authority to the certificates of the container,
	# so PHP trusts the sites it serves over HTTPS (Authelia in the development stack).

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME::80} {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
	}

	root /app/public
	encode zstd br gzip

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	# The Mercure hub built into FrankenPHP, at /.well-known/mercure: it tells the pages that an
	# issue changed (src/Realtime/). It trusts the tokens the application signs with
	# MERCURE_JWT_SECRET as MERCURE_JWT_ISSUER; no anonymous subscriber, no history. The secret
	# has no default: the development stack sets its own (compose.yaml).
	mercure {
		transport local
		issuer {$MERCURE_JWT_ISSUER:https://localhost} {
			publisher {
				jwt "{$MERCURE_JWT_SECRET}"
			}
			subscriber {
				jwt "{$MERCURE_JWT_SECRET}"
			}
		}
	}

	# Classic mode: one PHP execution per request, no shared state between requests.
	php_server {
		{$FRANKENPHP_SITE_CONFIG}
	}
}
