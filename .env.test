# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

###> cairn ###
# One folder per ParaTest worker (TEST_TOKEN), like the database: tests write and prune files.
ATTACHMENTS_DIR=%kernel.project_dir%/var/attachments_test${TEST_TOKEN:-}
IMPORTS_DIR=%kernel.project_dir%/var/imports_test${TEST_TOKEN:-}
# The files of flock are shared by the workers, which each sync their own configuration.
LOCK_DSN=in-memory
###< cairn ###

###> symfony/mercure-bundle ###
# No hub in the tests, which still sign the tokens of the pages.
MERCURE_JWT_SECRET=cairn-test-mercure-jwt-secret-of-32-characters-or-more
###< symfony/mercure-bundle ###
