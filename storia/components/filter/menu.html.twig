<twig:Ui:Filter:Menu :label="label" :count="count">
    {% for option in options %}
        <twig:Ui:Filter:Option name="criticality[]" :value="option.value" :count="option.count" :checked="option.checked|default(false)">{{ option.label }}</twig:Ui:Filter:Option>
    {% endfor %}
</twig:Ui:Filter:Menu>
