<twig:Ui:Form:RadioCard :title="title" :description="description" name="choice" value="1" :checked="checked|default(false)" :large="large|default(false)" :dashed="dashed|default(false)">
    <twig:block name="badge">{% if badge|default(null) %}<twig:Ui:Badge tone="amber" icon="lock" size="sm" class="ml-auto">{{ badge }}</twig:Ui:Badge>{% endif %}</twig:block>
</twig:Ui:Form:RadioCard>
