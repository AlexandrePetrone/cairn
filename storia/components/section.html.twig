<twig:Ui:Section :title="title" :icon="icon" :tone="tone" :count="count" :open="open" :foldable="foldable">
    <twig:block name="summary"><span class="ml-1 min-w-0 truncate text-xs text-gray-500">{{ summary }}</span></twig:block>
    <twig:block name="actions"><a href="#" class="shrink-0 text-xs text-indigo-600 hover:underline">{{ action }}</a></twig:block>
    <twig:block name="content"><p class="text-[13px] text-gray-800">{{ content }}</p></twig:block>
</twig:Ui:Section>
