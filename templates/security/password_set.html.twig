{% extends 'security/layout.html.twig' %}

{% block title %}{{ 'auth.password.set.title'|trans }} · Cairn{% endblock %}

{% block card %}
    {{ form_start(form, { attr: { class: 'rounded-lg border border-gray-200 bg-white p-6 space-y-4' } }) }}
        <h1 class="text-base font-semibold text-gray-900">{{ 'auth.password.set.title'|trans }}</h1>
        <p class="text-sm text-gray-500">{{ 'auth.password.set.intro'|trans({ '%email%': user.email }) }}</p>
        {{ form_errors(form.password) }}
        {{ form_row(form.password.first) }}
        {{ form_row(form.password.second) }}
        <twig:Ui:Button variant="primary" size="lg" type="submit" class="w-full">{{ 'auth.password.set.submit'|trans }}</twig:Ui:Button>
    {{ form_end(form) }}
{% endblock %}
