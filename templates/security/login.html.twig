{% extends 'security/layout.html.twig' %}

{% block title %}{{ 'auth.login.title'|trans }} · Cairn{% endblock %}

{% block card %}
    <form method="post" action="{{ path('app_login') }}" class="rounded-lg border border-line bg-surface p-6 space-y-4">
        <h1 class="text-base font-semibold text-strong">{{ 'auth.login.title'|trans }}</h1>

        {% if error %}
            <twig:Ui:Callout tone="danger" size="sm" class="border-red-line bg-red-soft text-red" role="alert">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </twig:Ui:Callout>
        {% endif %}

        <twig:Ui:Form:Field :label="'auth.login.email'|trans" for="email" required>
            <twig:Ui:Form:Input type="email" id="email" name="email" :value="lastEmail" autocomplete="email" required autofocus />
        </twig:Ui:Form:Field>

        <twig:Ui:Form:Field :label="'auth.login.password'|trans" for="password" required>
            <twig:Ui:Form:Input type="password" id="password" name="password" autocomplete="current-password" required />
            <a href="{{ path('app_password_request') }}" class="mt-1 inline-block text-xs text-brand hover:underline">{{ 'auth.login.forgot'|trans }}</a>
        </twig:Ui:Form:Field>

        <twig:Ui:Form:Checkbox name="_remember_me" :label="'auth.login.remember_me'|trans" />

        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

        <twig:Ui:Button variant="primary" size="lg" type="submit" class="w-full">{{ 'auth.login.submit'|trans }}</twig:Ui:Button>

        {% if ssoName %}
            <div class="flex items-center gap-3 text-xs text-faint">
                <span class="h-px flex-1 bg-line"></span>
                {{ 'auth.login.or'|trans }}
                <span class="h-px flex-1 bg-line"></span>
            </div>
            {# Leaves the site: not a Turbo visit. #}
            <twig:Ui:Button :href="path('_oidc_login_start_main')" size="lg" icon="key-round" class="w-full" data-turbo="false">{{ 'auth.login.sso'|trans({ '%name%': ssoName }) }}</twig:Ui:Button>
        {% endif %}
    </form>
{% endblock %}
