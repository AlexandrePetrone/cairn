{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.login.title'|trans }} · Cairn{% endblock %}

{% block body %}
    <main class="min-h-screen grid place-items-center px-4">
        <div class="w-full max-w-sm">
            <div class="mb-6 flex items-center justify-center gap-2">
                <span class="h-8 w-8 rounded bg-indigo-500 grid place-items-center text-white font-bold">C</span>
                <span class="text-lg font-semibold text-gray-900">Cairn</span>
            </div>

            <form method="post" action="{{ path('app_login') }}" class="rounded-lg border border-gray-200 bg-white p-6 space-y-4">
                <h1 class="text-base font-semibold text-gray-900">{{ 'auth.login.title'|trans }}</h1>

                {% if error %}
                    <twig:Callout tone="danger" size="sm" class="border-red-200 bg-red-50 text-red-700" role="alert">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </twig:Callout>
                {% endif %}

                <twig:Form:Field :label="'auth.login.email'|trans" for="email" required>
                    <twig:Form:Input type="email" id="email" name="email" :value="lastEmail" autocomplete="email" required autofocus />
                </twig:Form:Field>

                <twig:Form:Field :label="'auth.login.password'|trans" for="password" required>
                    <twig:Form:Input type="password" id="password" name="password" autocomplete="current-password" required />
                </twig:Form:Field>

                <twig:Form:Checkbox name="_remember_me" :label="'auth.login.remember_me'|trans" />

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                <twig:Button variant="primary" size="lg" type="submit" class="w-full">{{ 'auth.login.submit'|trans }}</twig:Button>
            </form>
        </div>
    </main>
{% endblock %}
