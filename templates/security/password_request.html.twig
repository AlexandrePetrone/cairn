{% extends 'security/layout.html.twig' %}

{% block title %}{{ 'auth.password.request.title'|trans }} · Cairn{% endblock %}

{% block card %}
    {{ form_start(form, { attr: { class: 'rounded-lg border border-gray-200 bg-white p-6 space-y-4' } }) }}
        <h1 class="text-base font-semibold text-gray-900">{{ 'auth.password.request.title'|trans }}</h1>
        <p class="text-sm text-gray-500">{{ 'auth.password.request.intro'|trans }}</p>
        {{ form_row(form.email) }}
        <twig:Ui:Button variant="primary" size="lg" type="submit" class="w-full">{{ 'auth.password.request.submit'|trans }}</twig:Ui:Button>
        <a href="{{ path('app_login') }}" class="block text-center text-xs text-indigo-600 hover:underline">{{ 'auth.password.back_to_login'|trans }}</a>
    {{ form_end(form) }}
{% endblock %}
