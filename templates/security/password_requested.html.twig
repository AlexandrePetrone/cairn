{% extends 'security/layout.html.twig' %}

{% block title %}{{ 'auth.password.requested.title'|trans }} · Cairn{% endblock %}

{% block card %}
    <div class="rounded-lg border border-line bg-surface p-6 space-y-4">
        <h1 class="text-base font-semibold text-strong">{{ 'auth.password.requested.title'|trans }}</h1>
        <p class="text-sm text-muted">{{ 'auth.password.requested.text'|trans }}</p>
        <a href="{{ path('app_login') }}" class="block text-center text-xs text-brand hover:underline">{{ 'auth.password.back_to_login'|trans }}</a>
    </div>
{% endblock %}
