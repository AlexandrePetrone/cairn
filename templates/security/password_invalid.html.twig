{% extends 'security/layout.html.twig' %}

{% block title %}{{ 'auth.password.invalid.title'|trans }} · Cairn{% endblock %}

{% block card %}
    <div class="rounded-lg border border-line bg-surface p-6 space-y-4">
        <h1 class="text-base font-semibold text-strong">{{ 'auth.password.invalid.title'|trans }}</h1>
        <twig:Ui:Callout tone="danger" size="sm" role="alert">{{ reason }}</twig:Ui:Callout>
        <p class="text-sm text-muted">{{ 'auth.password.invalid.text'|trans }}</p>
        <twig:Ui:Button variant="primary" size="lg" href="{{ path('app_password_request') }}" class="w-full">{{ 'auth.password.invalid.request_again'|trans }}</twig:Ui:Button>
        <a href="{{ path('app_login') }}" class="block text-center text-xs text-brand hover:underline">{{ 'auth.password.back_to_login'|trans }}</a>
    </div>
{% endblock %}
