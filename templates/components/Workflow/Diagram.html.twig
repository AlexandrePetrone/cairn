{# The graph of a workflow: the Mermaid source, drawn by the `workflow-diagram` controller, and the legend of colours, lines and outlines. With `current`, the place of an issue, the drawing stands alone, without the legend: it is shown to users, who read no status. The source only shows when drawing fails; the table of actions next to the diagram tells the same without JavaScript. #}
<div {{ attributes.defaults({ class: 'space-y-2' }) }}>
    <div class="overflow-x-auto rounded-md border border-line bg-surface p-3" data-controller="workflow-diagram">
        <div data-workflow-diagram-target="canvas" data-live-ignore class="flex min-w-max min-h-24 justify-center"></div>
        <pre data-workflow-diagram-target="source" class="text-xs text-muted whitespace-pre" hidden>{{ this.source }}</pre>
    </div>
    {% if not this.current %}
        <p class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted">
            {% for status in ['open', 'in_progress', 'waiting', 'closed'] %}
                <span class="inline-flex items-center gap-1.5"><twig:Ui:Status:Dot :status="status" size="md" />{{ ('status.' ~ status)|trans }}</span>
            {% endfor %}
            <span>{{ 'workflow.diagram.path'|trans }}</span>
            <span>{{ 'workflow.diagram.action'|trans }}</span>
            <span>{{ 'workflow.diagram.acted'|trans }}</span>
            <span>{{ 'workflow.diagram.aside'|trans }}</span>
            <span>{{ 'workflow.diagram.dotted'|trans }}</span>
            <span>{{ 'workflow.diagram.comment'|trans }}</span>
        </p>
    {% endif %}
</div>
