{# What the open budgets of the project amount to together: their volume, what was consumed, what is left and what waits for an approval. `this` is read before the nested components. #}
{% set totalsCount = this.count %}
{% set totalsVolume = this.volume %}
{% set totalsConsumed = this.consumed %}
{% set totalsRemaining = this.remaining %}
{% set totalsPending = this.pending %}
<div {{ attributes.defaults({ class: 'grid grid-cols-2 gap-3 lg:grid-cols-4' }) }} data-loading="addClass(opacity-60)">
    <twig:Ui:StatTile :label="'budget.total.volume'|trans" :value="totalsVolume|quantity(project)" :caption="'budget.total.volume_caption'|trans({ '%count%': totalsCount })" />
    <twig:Ui:StatTile :label="'budget.consumed'|trans" :value="totalsConsumed|quantity(project)" :caption="'budget.total.consumed_caption'|trans" />
    <twig:Ui:StatTile :label="'budget.total.remaining'|trans" :value="totalsRemaining|quantity(project)" :caption="'budget.total.remaining_caption'|trans" />
    <twig:Ui:StatTile :label="'budget.pending'|trans" :value="totalsPending|quantity(project)" :caption="'budget.total.pending_caption'|trans" />
</div>
