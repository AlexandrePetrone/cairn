{# <details> with an open/closed label and a rotating chevron; no JavaScript. #}
{% props openLabel, closedLabel, open = false %}
{% set disclosureClasses = html_cva(base: 'group') %}
<details class="{{ disclosureClasses.apply({}, attributes.render('class'))|tailwind_merge }}" {{ open ? 'open' }} {{ attributes }}>
    <summary class="list-none cursor-pointer inline-flex items-center gap-1 text-xs text-indigo-600 hover:underline">
        <span class="group-open:hidden">{{ closedLabel }}</span>
        <span class="hidden group-open:inline">{{ openLabel }}</span>
        <twig:ux:icon name="lucide:chevron-down" class="h-3 w-3 transition group-open:rotate-180" />
    </summary>
    <div class="mt-2">{% block content %}{% endblock %}</div>
</details>
