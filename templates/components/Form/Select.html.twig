{# Options go in the block. `inline` is the compact row variant of role pickers. #}
{% props inline = false %}
{% set selectClasses = html_cva(
    base: 'rounded-md border border-gray-300 bg-white px-2 text-sm disabled:bg-gray-50 disabled:text-gray-500',
    variants: {
        inline: { true: 'h-8 text-gray-700', false: 'mt-1 w-full h-9 focus:border-indigo-400 focus:outline-none' },
    },
) %}
<select class="{{ selectClasses.apply({ inline: inline }, attributes.render('class'))|tailwind_merge }}" {{ attributes }}>{% block content %}{% endblock %}</select>
