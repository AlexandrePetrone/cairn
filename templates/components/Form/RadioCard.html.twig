{# A selectable card; `name`, `value`, `id`, `required` and `disabled` go to the radio input (category choice, criticality). `large` for category cards, `dashed` marks internal-only choices. #}
{% props title, description = null, checked = false, dashed = false, large = false %}
{% set radioCardClasses = html_cva(
    base: 'block cursor-pointer bg-white has-[:checked]:border-indigo-600 has-[:checked]:bg-indigo-50/40 has-[:disabled]:cursor-not-allowed has-[:disabled]:opacity-60',
    variants: {
        large: { true: 'rounded-lg border-2 p-4 hover:border-indigo-300', false: 'rounded-md border p-3 hover:border-gray-300' },
        dashed: { true: 'border-dashed border-gray-300', false: 'border-gray-200' },
    },
) %}
<label class="{{ radioCardClasses.apply({ large: large, dashed: dashed }, attributes.render('class'))|tailwind_merge }}" {{ attributes.without('name', 'value', 'id', 'required', 'disabled', 'class') }}>
    <input type="radio" {{ attributes.only('name', 'value', 'id', 'required', 'disabled') }} {{ checked ? 'checked' }} class="sr-only">
    <div class="flex items-center gap-2">
        <span class="font-medium text-gray-900">{{ title }}</span>
        {% block badge %}{% endblock %}
    </div>
    {% if description %}<p class="mt-1 text-sm text-gray-600 leading-snug">{{ description }}</p>{% endif %}
    {% block content %}{% endblock %}
</label>
