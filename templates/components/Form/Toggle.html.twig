{# Switch; `name` and `value` (default 1) go to the checkbox; amber when it guards something private. #}
{% props label, checked = false, tone = 'amber' %}
{% set toggleClasses = html_cva(base: 'inline-flex items-center gap-2 text-xs text-gray-600 cursor-pointer select-none') %}
{% set toggleTrackClasses = html_cva(
    base: 'relative inline-block h-4 w-7 rounded-full bg-gray-300 transition',
    variants: { tone: { amber: 'has-[:checked]:bg-amber-500', indigo: 'has-[:checked]:bg-indigo-600' } },
) %}
<label class="{{ toggleClasses.apply({}, attributes.render('class'))|tailwind_merge }}" {{ attributes.without('name', 'value', 'class') }}>
    <span class="{{ toggleTrackClasses.apply({ tone: tone }) }}">
        <input type="checkbox" {{ attributes.defaults({ value: '1' }).only('name', 'value') }} {{ checked ? 'checked' }} class="peer sr-only">
        <span class="absolute left-0.5 top-0.5 h-3 w-3 rounded-full bg-white shadow transition peer-checked:translate-x-3"></span>
    </span>
    {{ label }}
</label>
