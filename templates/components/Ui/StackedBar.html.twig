{# Proportions by status. `segments` is a list of { status, value }. #}
{% props segments, size = 'md' %}
{% set stackedBarClasses = html_cva(
    base: 'flex rounded-full overflow-hidden bg-gray-100',
    variants: { size: { sm: 'h-2 gap-px', md: 'h-3 gap-0.5' } },
) %}
{% set stackedBarSegmentClasses = html_cva(
    variants: { status: { open: 'bg-blue-500', in_progress: 'bg-amber-500', waiting: 'bg-violet-500', closed: 'bg-gray-400' } },
) %}
{% set stackedBarTotal = segments|column('value')|reduce((sum, value) => sum + value, 0) %}
<div class="{{ stackedBarClasses.apply({ size: size }, attributes.render('class'))|tailwind_merge }}" {{ attributes }}>
    {% for item in segments|filter(item => item.value > 0) %}
        <div class="{{ stackedBarSegmentClasses.apply({ status: item.status }) }}" style="width: {{ stackedBarTotal ? (item.value / stackedBarTotal * 100)|round(1) : 0 }}%" title="{{ ('status.' ~ item.status)|trans }} : {{ item.value }}"></div>
    {% endfor %}
</div>
