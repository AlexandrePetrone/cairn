{# ▲ for high and blocking, ● normal, ▽ low. `iconOnly` shows the glyph alone, and only when it matters. #}
{% props criticality, iconOnly = false %}
{% set criticalityGlyphs = { blocking: '▲', high: '▲', normal: '●', low: '▽' } %}
{% set criticalityBadgeClasses = html_cva(
    base: 'inline-flex items-center gap-1 rounded-md px-1.5 py-0.5 text-xs font-medium ring-1 ring-inset',
    variants: {
        criticality: {
            blocking: 'bg-red-soft text-red ring-red-line',
            high: 'bg-orange-soft text-orange ring-orange-line',
            normal: 'bg-subtle text-muted ring-line',
            low: 'bg-subtle text-faint ring-line',
        },
    },
) %}
{% set criticalityGlyphClasses = html_cva(
    base: 'text-[9px]',
    variants: { criticality: { blocking: 'text-red', high: 'text-orange' } },
) %}
{% if iconOnly %}
    {% if criticality in ['blocking', 'high'] %}
        <span class="{{ criticalityGlyphClasses.apply({ criticality: criticality }, attributes.render('class'))|tailwind_merge }}" title="{{ ('criticality.' ~ criticality)|trans }}" {{ attributes }}>{{ criticalityGlyphs[criticality] }}</span>
    {% endif %}
{% else %}
    <span class="{{ criticalityBadgeClasses.apply({ criticality: criticality }, attributes.render('class'))|tailwind_merge }}" {{ attributes }}>
        <span class="text-[9px]">{{ criticalityGlyphs[criticality] }}</span>
        {{ ('criticality.' ~ criticality)|trans }}
    </span>
{% endif %}
