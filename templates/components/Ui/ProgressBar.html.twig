{# How far a piece of work went: `value` out of `max`, as a bar with its figures for screen readers. Without `max` (not known yet), a pulsing stripe. `tone`: brand while it goes, emerald when done. #}
{% props value = 0, max = null, tone = 'brand', size = 'md', label = null %}
{% set progressBarClasses = html_cva(
    base: 'relative w-full overflow-hidden rounded-full bg-sunken',
    variants: { size: { sm: 'h-1.5', md: 'h-2.5' } },
) %}
{% set progressBarFillClasses = html_cva(
    base: 'h-full rounded-full transition-[width] duration-500',
    variants: {
        tone: { brand: 'bg-brand-solid', emerald: 'bg-emerald-solid' },
        known: { false: 'w-1/3 animate-pulse' },
    },
) %}
{% set progressBarPercent = max ? min(100, (value / max * 100)|round) : null %}
<div role="progressbar" aria-valuemin="0" {% if max %}aria-valuemax="{{ max }}" aria-valuenow="{{ min(value, max) }}"{% endif %} {% if label %}aria-label="{{ label }}"{% endif %}
     class="{{ progressBarClasses.apply({ size: size }, attributes.render('class'))|tailwind_merge }}" {{ attributes }}>
    <div class="{{ progressBarFillClasses.apply({ tone: tone, known: progressBarPercent is not null }) }}" {% if progressBarPercent is not null %}style="width: {{ progressBarPercent }}%"{% endif %}></div>
</div>
