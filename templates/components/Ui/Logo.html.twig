{# The mark of Cairn, three flat stones balanced one on another, drawn in the current colour (brand by default); the name beside it is the caller's. `public/favicon.svg` is its version for the browser tab. #}
{% props size = 'md' %}
{% set logoClasses = html_cva(
    base: 'shrink-0 text-brand',
    variants: { size: { sm: 'h-6 w-6', md: 'h-8 w-8', lg: 'h-12 w-12' } },
) %}
<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round" aria-hidden="true" class="{{ logoClasses.apply({ size: size }, attributes.render('class'))|tailwind_merge }}" {{ attributes }}>
    <rect x="6" y="43" width="44" height="9" rx="4.5"/>
    <rect x="16" y="29" width="40" height="8" rx="4" transform="rotate(-3 36 33)"/>
    <rect x="12" y="15" width="27" height="8" rx="4" transform="rotate(4 25.5 19)"/>
</svg>
