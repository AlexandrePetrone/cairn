{# Small generic label: account and release states, "Admin", "Private" with its lock, counts. For issue status or criticality use Status:Badge and Criticality:Badge. #}
{% props tone = 'gray', icon = null, size = 'md' %}
{% set badgeClasses = html_cva(
    base: 'inline-flex items-center gap-1 font-medium ring-1 ring-inset align-middle',
    variants: {
        tone: {
            gray: 'bg-sunken text-muted ring-line',
            emerald: 'bg-emerald-soft text-emerald ring-emerald-line',
            blue: 'bg-blue-soft text-blue ring-blue-line',
            violet: 'bg-violet-soft text-violet ring-violet-line',
            amber: 'bg-amber-soft text-amber ring-amber-line',
            red: 'bg-red-soft text-red ring-red-line',
            indigo: 'bg-brand-soft text-brand ring-brand-line',
        },
        size: {
            sm: 'rounded px-1 py-px text-[10px] [&>svg]:h-2.5 [&>svg]:w-2.5',
            md: 'rounded-md px-1.5 py-0.5 text-xs [&>svg]:h-3 [&>svg]:w-3',
        },
    },
) %}
<span class="{{ badgeClasses.apply({ tone: tone, size: size }, attributes.render('class'))|tailwind_merge }}" {{ attributes }}>
    {% if icon %}{{ ux_icon('lucide:' ~ icon) }}{% endif %}
    {% block content %}{% endblock %}
</span>
