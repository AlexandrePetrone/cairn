{# Boxed note. `tone`: gray for information, amber for signals, blue for hints, danger for the danger zone, private for internal-only sections. `size`: sm for a one-line note, md for a section. #}
{% props tone = 'gray', size = 'md' %}
{% set calloutClasses = html_cva(
    base: 'border',
    variants: {
        tone: {
            gray: 'border-line bg-subtle text-muted',
            amber: 'border-amber-line bg-amber-soft/60 text-amber',
            blue: 'border-blue-line bg-blue-soft text-blue',
            danger: 'border-red-line bg-surface text-body',
            private: 'border-amber-line bg-amber-soft/40 private-hatching text-amber',
        },
        size: {
            sm: 'rounded-md px-3 py-2 text-xs',
            md: 'rounded-lg p-4 text-sm',
        },
    },
) %}
<div class="{{ calloutClasses.apply({ tone: tone, size: size }, attributes.render('class'))|tailwind_merge }}" {{ attributes }}>{% block content %}{% endblock %}</div>
