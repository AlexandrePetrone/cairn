{% props label, value, caption = null, status = null %}
{% set statTileClasses = html_cva(base: 'rounded-lg border border-line bg-surface p-4 hover:border-brand-line transition') %}
<div class="{{ statTileClasses.apply({}, attributes.render('class'))|tailwind_merge }}" {{ attributes }}>
    <div class="flex items-center gap-1.5 text-xs text-muted">
        {% if status %}<twig:Ui:Status:Dot status="{{ status }}" size="md" />{% endif %}
        {{ label }}
    </div>
    <div class="mt-1 text-3xl font-semibold tabular-nums text-strong">{{ value }}</div>
    {% if caption %}<div class="mt-0.5 text-xs text-faint">{{ caption }}</div>{% endif %}
</div>
