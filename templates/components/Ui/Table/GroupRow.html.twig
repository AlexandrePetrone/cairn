{# The header of a group in a table: a chevron that folds it (the button carries the attributes, the live action), the label in the content, `count` the size of the group. `colspan` spans the columns of the table. #}
{% props count = null, collapsed = false, colspan = 1 %}
{% set tableGroupRowClasses = html_cva(base: 'flex sm:table-row bg-gray-50/80 border-t border-gray-200') %}
{% set tableGroupRowChevronClasses = html_cva(
    base: 'h-3.5 w-3.5 text-gray-400 transition-transform',
    variants: { collapsed: { false: 'rotate-90' } },
) %}
<tr class="{{ tableGroupRowClasses.apply({}, attributes.render('class'))|tailwind_merge }}">
    <th colspan="{{ colspan }}" scope="rowgroup" class="w-full px-3 py-2 text-left text-sm font-medium text-gray-800">
        <button type="button" class="inline-flex items-center gap-2" aria-expanded="{{ collapsed ? 'false' : 'true' }}" {{ attributes }}>
            <twig:ux:icon name="lucide:chevron-right" class="{{ tableGroupRowChevronClasses.apply({ collapsed: collapsed }) }}" />
            {% block content %}{% endblock %}
            {% if count is not null %}<span class="text-xs font-normal text-gray-400 tabular-nums">{{ count }}</span>{% endif %}
        </button>
    </th>
</tr>
