{# A tab link. Put tabs in <nav class="flex items-center gap-1 border-b border-gray-200">. #}
{% props href = '#', active = false, count = null, icon = null, right = false %}
{% set tabClasses = html_cva(
    base: 'inline-flex items-center gap-1.5 px-3 py-2 text-sm border-b-2 -mb-px',
    variants: {
        active: { true: 'border-indigo-600 text-indigo-700 font-medium', false: 'border-transparent text-gray-600 hover:text-gray-900 hover:border-gray-300' },
        right: { true: 'ml-auto' },
    },
) %}
{% set tabCountClasses = html_cva(base: 'text-xs', variants: { active: { true: 'text-indigo-500', false: 'text-gray-400' } }) %}
<a href="{{ href }}" class="{{ tabClasses.apply({ active: active, right: right }, attributes.render('class'))|tailwind_merge }}" {% if active %}aria-current="page"{% endif %} {{ attributes }}>
    {% if icon %}{{ ux_icon('lucide:' ~ icon, { class: 'h-4 w-4' }) }}{% endif %}
    {% block content %}{% endblock %}
    {% if count is not null %}<span class="{{ tabCountClasses.apply({ active: active }) }}">{{ count }}</span>{% endif %}
</a>
