{# What a forge told about an issue, as a card of the thread: a merge request (its number, title, state, source branch and author) or the commits of a push (the branch; the rows are the content). `kind`: merge_request or commit. `heading` is the link to the forge, `repository` and `at` sit beside it, `internal` adds the badge the private comments wear. #}
{% props kind = 'commit', heading, href = null, repository = null, at = null, title = null, state = null, branch = null, author = null, internal = false %}
{% set codeCardClasses = html_cva(base: 'rounded-lg border border-gray-200 bg-white p-3 text-sm') %}
{% set codeCardStateTones = { opened: 'blue', reopened: 'blue', merged: 'violet', closed: 'gray' } %}
<div class="{{ codeCardClasses.apply({}, attributes.render('class'))|tailwind_merge }}" {{ attributes }}>
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-gray-500">
        {{ ux_icon(kind == 'merge_request' ? 'lucide:git-pull-request' : 'lucide:git-commit-horizontal', { class: 'h-3.5 w-3.5 shrink-0 text-gray-400' }) }}
        {% if href %}
            <a href="{{ href }}" target="_blank" rel="noopener" class="font-medium text-gray-900 hover:text-indigo-700 hover:underline">{{ heading }}</a>
        {% else %}
            <span class="font-medium text-gray-900">{{ heading }}</span>
        {% endif %}
        {% if repository %}<span class="font-mono text-gray-400">{{ repository }}</span>{% endif %}
        {% if at %}<span class="text-gray-400">· {{ at }}</span>{% endif %}
        {% if internal %}<twig:Ui:Badge tone="amber" size="sm" icon="lock" class="ml-auto">{{ 'issue.comment.private_badge'|trans }}</twig:Ui:Badge>{% endif %}
    </div>
    {% if title %}<div class="mt-1 font-medium text-gray-900">{{ title }}</div>{% endif %}
    {% block content %}{% endblock %}
    {% if state or branch or author %}
        <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-500">
            {% if state %}<twig:Ui:Badge :tone="codeCardStateTones[state]|default('gray')" size="sm">{{ ('issue.code.state.' ~ state)|trans }}</twig:Ui:Badge>{% endif %}
            {% if branch %}<span class="inline-flex items-center gap-1 font-mono"><twig:ux:icon name="lucide:git-branch" class="h-3 w-3" />{{ branch }}</span>{% endif %}
            {% if author %}<span class="ml-auto">{{ 'issue.code.by'|trans({ '%author%': author }) }}</span>{% endif %}
        </div>
    {% endif %}
</div>
