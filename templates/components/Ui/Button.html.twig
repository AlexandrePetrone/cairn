{# Renders <a> with `href`, <button> otherwise. `icon` is a Lucide name. #}
{% props variant = 'secondary', size = 'md', href = null, icon = null, type = 'button' %}
{% set buttonClasses = html_cva(
    base: 'inline-flex items-center justify-center gap-1.5 rounded-md whitespace-nowrap',
    variants: {
        size: { sm: 'h-7 px-2 text-xs', md: 'h-8 px-3 text-sm', lg: 'h-9 px-4 text-sm' },
        variant: {
            primary: 'bg-indigo-600 text-white font-medium hover:bg-indigo-700',
            secondary: 'border border-gray-300 bg-white text-gray-700 hover:bg-gray-50',
            danger: 'border border-red-200 bg-white text-red-700 hover:bg-red-50',
            dark: 'bg-gray-900 text-white font-medium hover:bg-gray-800',
            success: 'bg-emerald-600 text-white font-medium hover:bg-emerald-700',
            ghost: 'text-gray-600 hover:bg-gray-100',
            icon: 'w-8 px-0 border border-gray-300 bg-white text-gray-500 hover:bg-gray-50',
        },
    },
) %}
{% set buttonTag = href ? 'a' : 'button' %}
<{{ buttonTag }} {% if href %}href="{{ href }}"{% else %}type="{{ type }}"{% endif %} class="{{ buttonClasses.apply({ size: size, variant: variant }, attributes.render('class'))|tailwind_merge }}" {{ attributes }}>
    {% if icon %}{{ ux_icon('lucide:' ~ icon, { class: 'h-4 w-4' }) }}{% endif %}
    {% block content %}{% endblock %}
</{{ buttonTag }}>
