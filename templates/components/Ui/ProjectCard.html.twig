{# A project as a card leading to it: its key, name and workspace, the open issues, then those waiting and those blocking when there are any. `archived` mutes it. #}
{% props href, code, name, workspace, open = 0, waiting = 0, blocking = 0, archived = false %}
{% set projectCardClasses = html_cva(
    base: 'group flex flex-col rounded-lg border border-gray-200 bg-white p-4 hover:border-indigo-300 hover:shadow-sm',
    variants: { archived: { true: 'opacity-70' } },
) %}
<a href="{{ href }}" class="{{ projectCardClasses.apply({ archived: archived }, attributes.render('class'))|tailwind_merge }}" {{ attributes }}>
    <div class="flex items-center gap-2">
        <twig:Ui:Chip>{{ code }}</twig:Ui:Chip>
        {% if archived %}<twig:Ui:Badge size="sm" class="ml-auto">{{ 'project.summary.archived'|trans }}</twig:Ui:Badge>{% endif %}
    </div>
    <div class="mt-2 font-medium text-gray-900 group-hover:text-indigo-700 truncate">{{ name }}</div>
    <div class="text-xs text-gray-500 truncate">{{ workspace }}</div>
    <div class="mt-auto pt-3 flex items-center gap-3 text-xs text-gray-500">
        <span>{{ 'project.summary.open'|trans({ '%count%': open }) }}</span>
        <span class="ml-auto inline-flex items-center gap-2">
            {% if waiting %}<span class="inline-flex items-center gap-1" title="{{ 'project.summary.waiting'|trans }}"><twig:Ui:Status:Dot status="waiting" />{{ waiting }}</span>{% endif %}
            {% if blocking %}<span class="inline-flex items-center gap-1 text-red-600" title="{{ 'project.summary.blocking'|trans }}">▲ {{ blocking }}</span>{% endif %}
        </span>
    </div>
</a>
