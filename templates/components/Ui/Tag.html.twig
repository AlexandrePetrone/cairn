{# A tag of a project on an issue: its name beside a dot of its colour, one of the closed palette (TagColour). `sm` in the rows of a list and on the cards of a kanban. #}
{% props colour = 'gray', size = 'md' %}
{% set tagClasses = html_cva(
    base: "inline-flex max-w-full items-center font-medium text-body bg-surface ring-1 ring-inset ring-line align-middle before:shrink-0 before:rounded-full before:content-['']",
    variants: {
        colour: {
            red: 'before:bg-tag-red',
            orange: 'before:bg-tag-orange',
            amber: 'before:bg-tag-amber',
            yellow: 'before:bg-tag-yellow',
            lime: 'before:bg-tag-lime',
            green: 'before:bg-tag-green',
            emerald: 'before:bg-tag-emerald',
            teal: 'before:bg-tag-teal',
            cyan: 'before:bg-tag-cyan',
            sky: 'before:bg-tag-sky',
            blue: 'before:bg-tag-blue',
            indigo: 'before:bg-tag-indigo',
            violet: 'before:bg-tag-violet',
            purple: 'before:bg-tag-purple',
            fuchsia: 'before:bg-tag-fuchsia',
            pink: 'before:bg-tag-pink',
            rose: 'before:bg-tag-rose',
            brown: 'before:bg-tag-brown',
            slate: 'before:bg-tag-slate',
            gray: 'before:bg-tag-gray',
        },
        size: {
            sm: 'gap-1 rounded px-1 py-px text-[10px] before:h-1.5 before:w-1.5',
            md: 'gap-1.5 rounded-md px-1.5 py-0.5 text-xs before:h-2 before:w-2',
        },
    },
) %}
<span class="{{ tagClasses.apply({ colour: colour, size: size }, attributes.render('class'))|tailwind_merge }}" {{ attributes }}><span class="truncate">{% block content %}{% endblock %}</span></span>
