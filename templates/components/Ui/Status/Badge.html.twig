{% props status %}
{% set statusBadgeClasses = html_cva(
    base: 'inline-flex items-center gap-1.5 rounded-md px-1.5 py-0.5 text-xs font-medium ring-1 ring-inset',
    variants: {
        status: {
            open: 'bg-blue-soft text-blue ring-blue-line',
            in_progress: 'bg-amber-soft text-amber ring-amber-line',
            waiting: 'bg-violet-soft text-violet ring-violet-line',
            closed: 'bg-sunken text-muted ring-line',
        },
    },
) %}
<span class="{{ statusBadgeClasses.apply({ status: status }, attributes.render('class'))|tailwind_merge }}" {{ attributes }}>
    <twig:Ui:Status:Dot status="{{ status }}" />
    {{ ('status.' ~ status)|trans }}
</span>
