{# A place as users see it: its colour and its label, as a dot and text or, with `pill`, on a background of the same colour. The status of the place is shown only with `withStatus`, in the configuration of the administration; users never see it. #}
{% props status, label, withStatus = false, pill = false %}
{% set statusStepClasses = html_cva(
    base: 'inline-flex items-center gap-1.5',
    variants: {
        pill: { true: 'rounded-md px-2 py-0.5 text-xs font-medium ring-1 ring-inset', false: '' },
        status: { open: '', in_progress: '', waiting: '', closed: '' },
    },
    compoundVariants: [
        { pill: [true], status: ['open'], class: 'bg-blue-soft text-blue ring-blue-line' },
        { pill: [true], status: ['in_progress'], class: 'bg-amber-soft text-amber ring-amber-line' },
        { pill: [true], status: ['waiting'], class: 'bg-violet-soft text-violet ring-violet-line' },
        { pill: [true], status: ['closed'], class: 'bg-sunken text-muted ring-line' },
    ],
) %}
<span class="{{ statusStepClasses.apply({ status: status, pill: pill }, attributes.render('class'))|tailwind_merge }}" {{ attributes }}>
    <twig:Ui:Status:Dot status="{{ status }}" />
    <span class="{{ pill ? '' : 'text-body' }}">{{ label }}</span>
    {% if withStatus %}<span class="text-[11px] text-faint">· {{ ('status.' ~ status)|trans }}</span>{% endif %}
</span>
