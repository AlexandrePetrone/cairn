{# Rich text written as markdown (editor controller). The content block is the markdown; `name` goes to the hidden textarea that carries it (never `required`: the browser cannot point at a hidden field, the server validates), everything else to the root, where `editor:submit` and `editor:cancel` arrive.
   `model` becomes the textarea's `data-model` inside a live component: passed as a plain `data-model` attribute, Live would bind the editor itself to the parent.
   Without the suggestion URLs, `#` and `@` are plain text; without `uploadUrl`, pasted images are refused. `issue` is the key of the issue being edited, for the uploads. #}
{% props placeholder = '', issuesUrl = '', usersUrl = '', uploadUrl = '', issue = '', rows = 4, invalid = false, autofocus = false, disabled = false, model = null %}
{% set editorClasses = html_cva(
    base: 'mt-1 w-full rounded-md border border-gray-300 bg-white focus-within:border-indigo-400 focus-within:ring-2 focus-within:ring-indigo-100',
    variants: {
        invalid: { true: 'border-red-400 focus-within:border-red-400 focus-within:ring-red-100' },
        disabled: { true: 'cursor-not-allowed bg-gray-50 text-gray-500' },
    },
) %}
{% set editorTools = [
    { command: 'bold', icon: 'bold' },
    { command: 'italic', icon: 'italic' },
    { command: 'strike', icon: 'strikethrough' },
    { command: 'code', icon: 'code' },
    { command: 'bulletList', icon: 'list' },
    { command: 'orderedList', icon: 'list-ordered' },
    { command: 'blockquote', icon: 'quote' },
    { command: 'link', icon: 'link' },
] %}
<div class="{{ editorClasses.apply({ invalid: invalid, disabled: disabled }, attributes.render('class'))|tailwind_merge }}"
     data-controller="editor"
     data-editor-issues-url-value="{{ issuesUrl }}"
     data-editor-users-url-value="{{ usersUrl }}"
     data-editor-upload-url-value="{{ uploadUrl }}"
     data-editor-issue-value="{{ issue }}"
     data-editor-placeholder-value="{{ placeholder }}"
     data-editor-link-prompt-value="{{ 'editor.link_prompt'|trans }}"
     data-editor-upload-failed-value="{{ 'editor.upload_failed'|trans }}"
     data-editor-images-only-value="{{ 'editor.images_only'|trans }}"
     data-editor-autofocus-value="{{ autofocus ? 'true' : 'false' }}"
     data-editor-editable-value="{{ disabled ? 'false' : 'true' }}"
     {{ attributes.without('name', 'required') }}>
    <div class="flex flex-wrap items-center gap-0.5 border-b border-gray-200 px-1.5 py-1" role="toolbar" data-live-ignore>
        {% for editorTool in editorTools %}
            <button type="button" {{ disabled ? 'disabled' }} title="{{ ('editor.' ~ editorTool.command)|trans }}" aria-label="{{ ('editor.' ~ editorTool.command)|trans }}" aria-pressed="false"
                    data-editor-target="button" data-action="editor#run" data-editor-command-param="{{ editorTool.command }}"
                    class="rounded p-1.5 text-gray-500 hover:bg-gray-100 hover:text-gray-900 disabled:pointer-events-none disabled:opacity-50 aria-pressed:bg-indigo-50 aria-pressed:text-indigo-700">
                {{ ux_icon('lucide:' ~ editorTool.icon, { class: 'h-4 w-4' }) }}
            </button>
        {% endfor %}
    </div>
    <div data-editor-target="content" data-live-ignore class="cursor-text px-3 py-2" style="min-height: {{ rows * 1.5 + 1 }}rem"></div>
    <textarea data-editor-target="input" hidden {{ attributes.only('name') }} {% if model %}data-model="{{ model }}"{% endif %}>{% block content %}{% endblock %}</textarea>
</div>
