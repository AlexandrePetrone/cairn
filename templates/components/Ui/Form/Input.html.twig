{# Text-like input. `invalid` turns the border red. `readonly` renders the grey monospace field of frozen values. `model` becomes its `data-model` in a live component. #}
{% props type = 'text', readonly = false, invalid = false, model = null %}
{% set inputClasses = html_cva(
    base: 'mt-1 w-full h-9 rounded-md border border-line-strong bg-surface text-sm',
    variants: {
        readonly: {
            true: 'flex items-center bg-subtle px-3 font-mono text-muted',
            false: 'px-3 focus:border-focus focus:outline-none focus:ring-2 focus:ring-brand-line disabled:cursor-not-allowed disabled:bg-subtle disabled:text-muted',
        },
        invalid: { true: 'border-red-solid focus:border-red-solid focus:ring-red-line' },
    },
) %}
{% set inputClass = inputClasses.apply({ readonly: readonly, invalid: invalid }, attributes.render('class'))|tailwind_merge %}
{% if readonly %}
    <div class="{{ inputClass }}" {{ attributes }}>{% block content %}{% endblock %}</div>
{% else %}
    <input type="{{ type }}" class="{{ inputClass }}" {{ attributes }}{% if model %} data-model="{{ model }}"{% endif %}>
{% endif %}
