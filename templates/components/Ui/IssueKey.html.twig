{# The identifier is everywhere: monospace, clickable when it has a link. `sm` on kanban cards, `lg` in the issue header. #}
{% props key, href = null, size = 'md' %}
{% set issueKeyClasses = html_cva(
    base: 'font-mono font-medium',
    variants: {
        size: { sm: 'text-[11px] text-muted', md: 'text-xs text-muted', lg: 'text-xs font-semibold text-body' },
        link: { true: 'hover:text-brand' },
    },
) %}
{% set issueKeyClass = issueKeyClasses.apply({ size: size, link: href is not null }, attributes.render('class'))|tailwind_merge %}
{% if href %}
    <a href="{{ href }}" class="{{ issueKeyClass }}" {{ attributes }}>{{ key }}</a>
{% else %}
    <span class="{{ issueKeyClass }}" {{ attributes }}>{{ key }}</span>
{% endif %}
