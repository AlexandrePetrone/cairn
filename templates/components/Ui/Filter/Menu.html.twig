{# One filter dimension: a dropdown of Filter:Option checkboxes. `count` is the number of selected values. Place the menus in a GET form. #}
{% props label, count = 0 %}
{% set filterMenuClasses = html_cva(base: 'relative') %}
{% set filterMenuTriggerClasses = html_cva(
    base: 'inline-flex h-7 items-center gap-1 rounded-md border bg-white px-2 text-xs text-gray-700 hover:bg-gray-50',
    variants: { active: { true: 'border-indigo-300 bg-indigo-50', false: 'border-gray-200' } },
) %}
<div class="{{ filterMenuClasses.apply({}, attributes.render('class'))|tailwind_merge }}" data-controller="dropdown" {{ attributes }}>
    <button type="button" data-action="dropdown#toggle" aria-expanded="false" class="{{ filterMenuTriggerClasses.apply({ active: count > 0 })|tailwind_merge }}">
        {{ label }}
        {% if count > 0 %}<span class="text-indigo-700 font-medium">{{ count }}</span>{% endif %}
        <twig:ux:icon name="lucide:chevron-down" class="h-3 w-3 text-gray-400" />
    </button>
    <div data-dropdown-target="menu" class="hidden absolute left-0 top-8 z-30 w-60 rounded-lg border border-gray-200 bg-white shadow-xl">
        <div class="py-1 max-h-64 overflow-y-auto">
            {% block content %}{% endblock %}
        </div>
    </div>
</div>
