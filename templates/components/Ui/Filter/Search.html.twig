{# The search field of a filter bar, w-72 unless the caller sets its width with `class`; `model` becomes its `data-model` in a live component. #}
{% props name = 'q', value = '', placeholder = null, model = null %}
{% set filterSearchClasses = html_cva(base: 'flex w-72 items-center gap-1.5 h-7 rounded-md border border-gray-200 bg-white px-2 text-gray-400 focus-within:border-indigo-400') %}
<label class="{{ filterSearchClasses.apply({}, attributes.render('class'))|tailwind_merge }}" {{ attributes }}>
    <twig:ux:icon name="lucide:search" class="h-3.5 w-3.5" />
    <input type="search" name="{{ name }}"{% if model %} data-model="{{ model }}"{% endif %} value="{{ value }}" placeholder="{{ placeholder ?? 'filter.search'|trans }}" class="w-full min-w-0 border-0 bg-transparent p-0 text-xs text-gray-800 outline-none placeholder:text-gray-400 focus:ring-0">
</label>
