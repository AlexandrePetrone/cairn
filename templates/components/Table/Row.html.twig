{# A row that becomes a wrapping card on small screens. Cells carry `sm:px-3 sm:py-2.5`. `separator` opens a new status group. #}
{% props closed = false, separator = false %}
{% set tableRowClasses = html_cva(
    base: 'group hover:bg-indigo-50/40 flex flex-wrap sm:table-row px-3 py-2.5 sm:p-0 gap-x-2',
    variants: {
        closed: { true: 'text-gray-500' },
        separator: { true: 'sm:border-t-4 sm:border-t-gray-100' },
    },
) %}
<tr class="{{ tableRowClasses.apply({ closed: closed, separator: separator }, attributes.render('class'))|tailwind_merge }}" {{ attributes }}>{% block content %}{% endblock %}</tr>
