{% props label, value, caption = null, status = null %}
{% set statTileClasses = html_cva(base: 'rounded-lg border border-gray-200 bg-white p-4 hover:border-indigo-300 transition') %}
<div class="{{ statTileClasses.apply({}, attributes.render('class'))|tailwind_merge }}" {{ attributes }}>
    <div class="flex items-center gap-1.5 text-xs text-gray-500">
        {% if status %}<twig:Status:Dot status="{{ status }}" size="md" />{% endif %}
        {{ label }}
    </div>
    <div class="mt-1 text-3xl font-semibold tabular-nums text-gray-900">{{ value }}</div>
    {% if caption %}<div class="mt-0.5 text-xs text-gray-400">{{ caption }}</div>{% endif %}
</div>
