{# The dialog of a move on the kanban, shown only while a move waits for a comment or for the choice of an action; the `board` controller calls `move` on this component. #}
{% set boardMoveIssue = this.issue %}
<div {{ attributes }} data-board-move>
    {% if boardMoveIssue %}
        {% set boardMoveChosen = this.chosen %}
        {% set boardMoveTransitions = this.transitions %}
        {% set boardMovePrivately = this.canCommentPrivately(boardMoveIssue) %}
        {% set boardMoveNeedsComment = boardMoveChosen and this.isCommentRequired(boardMoveChosen) %}
        <twig:Ui:Dialog :title="boardMoveChosen ? boardMoveChosen.label : 'issue.board.choose'|trans" closeAction="cancel">
            <twig:block name="description">
                <p class="truncate"><span class="font-mono">{{ boardMoveIssue.key }}</span> · {{ boardMoveIssue.title }}</p>
                {% if boardMoveChosen and boardMoveChosen.description %}<p class="mt-1 text-gray-600">{{ boardMoveChosen.description }}</p>{% endif %}
            </twig:block>
            {% if error %}<twig:Ui:Callout tone="danger" size="sm" role="alert">{{ error }}</twig:Ui:Callout>{% endif %}
            {% if boardMoveTransitions|length > 1 %}
                <label class="block text-sm text-gray-700">{{ 'issue.board.action'|trans }}
                    <twig:Ui:Form:Select model="transitionId" class="mt-1 h-9 w-full">
                        {% for transition in boardMoveTransitions %}
                            <option value="{{ transition.id }}" {{ transition.id == transitionId ? 'selected' }}>{{ transition.label }}</option>
                        {% endfor %}
                    </twig:Ui:Form:Select>
                </label>
            {% endif %}
            <label class="block text-sm text-gray-700">
                {{ 'issue.bulk.comment_label'|trans }}
                {% if boardMoveChosen and not boardMoveNeedsComment %}<span class="text-xs text-gray-400">{{ 'form.optional'|trans }}</span>{% endif %}
                <twig:Ui:Form:Textarea model="norender|comment" rows="4" :placeholder="boardMoveChosen and boardMoveChosen.commentPrompt ? boardMoveChosen.commentPrompt : ''" autofocus>{{ comment }}</twig:Ui:Form:Textarea>
            </label>
            {% if boardMovePrivately %}
                <twig:Ui:Form:Checkbox model="commentPrivate" :label="'issue.comment.private'|trans" :checked="commentPrivate" tone="amber" />
            {% endif %}
            <twig:block name="footer">
                <twig:Ui:Button variant="primary" data-action="live#action" data-live-action-param="confirm" data-loading="addAttribute(disabled)">{{ 'issue.board.apply'|trans }}</twig:Ui:Button>
                <twig:Ui:Button variant="ghost" data-action="live#action" data-live-action-param="cancel">{{ 'issue.edit.cancel'|trans }}</twig:Ui:Button>
            </twig:block>
        </twig:Ui:Dialog>
    {% endif %}
</div>
