{# The people following the issue, a card of the side panel, folded at first: their avatars on the header, the list when open. `this` is read before the nested components. #}
{% set subscribersList = this.subscribers %}
<div {{ attributes }} data-loading="addClass(opacity-60)">
    <twig:Ui:Section :title="'issue.subscribers.title'|trans" icon="bell" tone="amber" :count="subscribersList|length" :open="false">
        <twig:block name="summary">
            {% if subscribersList is not empty %}
                <twig:Ui:AvatarStack :overflow="max(0, subscribersList|length - 4)" class="ml-1 -space-x-1 [&>*]:h-5 [&>*]:w-5 [&>*]:text-[9px]">
                    {% for subscriber in subscribersList|slice(0, 4) %}
                        <twig:User:Avatar :user="subscriber" size="sm" />
                    {% endfor %}
                </twig:Ui:AvatarStack>
            {% endif %}
        </twig:block>
        <twig:block name="content">
            {% if subscribersList is empty %}
                <p class="text-xs text-faint">{{ 'issue.subscribers.none'|trans }}</p>
            {% else %}
                <ul class="space-y-1 text-[13px] text-body">
                    {% for subscriber in subscribersList %}
                        <li class="flex items-center gap-2">
                            <twig:User:Avatar :user="subscriber" size="sm" />
                            <span class="truncate">{{ subscriber.fullName }}</span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </twig:block>
    </twig:Ui:Section>
</div>
