{# The people following the issue, in its side panel. `this` is read before the nested components. #}
{% set subscribersList = this.subscribers %}
<div {{ attributes.defaults({ class: 'p-3' }) }} data-loading="addClass(opacity-60)">
    <div class="flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-gray-400">
        <twig:ux:icon name="lucide:bell" class="h-3 w-3" />{{ 'issue.subscribers.title'|trans }}
        <span class="ml-auto font-normal normal-case tracking-normal text-gray-400">{{ subscribersList|length }}</span>
    </div>
    {% if subscribersList is empty %}
        <p class="mt-2 text-xs text-gray-400">{{ 'issue.subscribers.none'|trans }}</p>
    {% else %}
        <ul class="mt-2 space-y-1.5">
            {% for subscriber in subscribersList %}
                <li class="flex items-center gap-2 text-xs text-gray-700">
                    <twig:Ui:Avatar :name="subscriber.fullName" :kind="subscriber.internal ? 'internal' : 'external'" size="xs" />
                    <span class="truncate">{{ subscriber.fullName }}</span>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>
