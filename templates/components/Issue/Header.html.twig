{# The top of the issue page: key, tracker, author, privacy, title and the path the issue took. Redrawn on `issue:changed`. #}
{% set headerPath = this.path %}
<div {{ attributes }}>
    <div>
        <div class="flex flex-wrap items-center gap-2 text-xs text-muted">
            <twig:Ui:IssueKey :key="issue.key" size="lg" />
            <span class="text-ghost">·</span>
            <span>{{ issue.tracker.name }}</span>
            <span class="text-ghost">·</span>
            <span>{{ 'issue.show.created_by'|trans({ '%name%': issue.author.fullName, '%date%': issue.createdAt|date('d/m/Y') }) }}</span>
            {% if issue.importedRef %}<span class="text-ghost">·</span><span>{{ 'issue.show.formerly'|trans({ '%ref%': issue.importedRef }) }}</span>{% endif %}
            {% if issue.private %}<twig:Ui:Badge tone="amber" size="sm" icon="lock">{{ 'issue.private'|trans }}</twig:Ui:Badge>{% endif %}
        </div>
        {% if editingTitle %}
            <form class="mt-1" data-action="live#action:prevent" data-live-action-param="saveTitle">
                <input type="text" data-model="norender|title" value="{{ title }}" maxlength="200" required aria-label="{{ 'issue.field.title'|trans }}"
                       data-controller="autofocus" data-action="keydown.esc->live#action" data-live-action-param="cancelTitle"
                       class="-mx-2 w-[calc(100%+1rem)] rounded-md border-0 bg-surface px-2 py-0.5 text-xl font-semibold leading-snug text-strong ring-2 ring-brand-line focus:outline-none focus:ring-focus">
                <p class="mt-1 text-xs text-faint">{{ 'issue.edit.title_hint'|trans }}</p>
            </form>
            {% if error %}<twig:Ui:Callout tone="danger" size="sm" role="alert" class="mt-2">{{ error }}</twig:Ui:Callout>{% endif %}
        {% elseif this.canEdit %}
            <div class="group mt-1 flex items-start gap-2">
                <h1 class="min-w-0 py-0.5 text-xl font-semibold leading-snug text-strong">{{ issue.title }}</h1>
                <twig:Ui:IconButton icon="pencil" :label="'issue.edit.edit_title'|trans" class="hover-actions mt-0.5" data-action="live#action" data-live-action-param="editTitle" />
            </div>
        {% else %}
            <h1 class="mt-1 py-0.5 text-xl font-semibold leading-snug text-strong">{{ issue.title }}</h1>
        {% endif %}

        {# The path as the journal tells it. #}
        <div class="mt-2 text-xs text-muted">
            <ol aria-label="{{ 'issue.show.path'|trans }}" class="flex flex-wrap items-center gap-x-1 gap-y-0.5">
                {% for step in headerPath %}
                    {% if not loop.first %}<li aria-hidden="true" class="text-ghost">→</li>{% endif %}
                    <li class="{{ loop.last ? 'font-medium text-strong' }} {{ step.moved ? 'underline decoration-dashed underline-offset-2' }}" {% if step.moved %}title="{{ 'issue.show.moved_step'|trans }}"{% endif %}>{{ step.label }}</li>
                {% endfor %}
            </ol>
        </div>
    </div>
</div>
