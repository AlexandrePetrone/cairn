{# The top of the issue page: key, tracker, author, privacy, title and the hint of the current place. Redrawn on `issue:changed`. #}
{% set headerPlace = this.place %}
<div {{ attributes }}>
    <div>
        <div class="flex flex-wrap items-center gap-2 text-xs text-gray-500">
            <twig:Ui:IssueKey :key="issue.key" size="lg" />
            <span class="text-gray-300">·</span>
            <span>{{ issue.tracker.name }}</span>
            <span class="text-gray-300">·</span>
            <span>{{ 'issue.show.created_by'|trans({ '%name%': issue.author.fullName, '%date%': issue.createdAt|date('d/m/Y') }) }}</span>
            {% if issue.private %}<twig:Ui:Badge tone="amber" size="sm" icon="lock">{{ 'issue.private'|trans }}</twig:Ui:Badge>{% endif %}
        </div>
        {% if editingTitle %}
            <form class="mt-1" data-action="live#action:prevent" data-live-action-param="saveTitle">
                <input type="text" data-model="norender|title" value="{{ title }}" maxlength="200" required aria-label="{{ 'issue.field.title'|trans }}"
                       data-controller="autofocus" data-action="keydown.esc->live#action" data-live-action-param="cancelTitle"
                       class="-mx-2 w-[calc(100%+1rem)] rounded-md border-0 bg-white px-2 py-0.5 text-xl font-semibold leading-snug text-gray-900 ring-2 ring-indigo-200 focus:outline-none focus:ring-indigo-400">
                <p class="mt-1 text-xs text-gray-400">{{ 'issue.edit.title_hint'|trans }}</p>
            </form>
            {% if error %}<twig:Ui:Callout tone="danger" size="sm" role="alert" class="mt-2">{{ error }}</twig:Ui:Callout>{% endif %}
        {% elseif this.canEdit %}
            <div class="group mt-1 flex items-start gap-2">
                <h1 class="min-w-0 py-0.5 text-xl font-semibold leading-snug text-gray-900">{{ issue.title }}</h1>
                <twig:Ui:IconButton icon="pencil" :label="'issue.edit.edit_title'|trans" class="hover-actions mt-0.5" data-action="live#action" data-live-action-param="editTitle" />
            </div>
        {% else %}
            <h1 class="mt-1 py-0.5 text-xl font-semibold leading-snug text-gray-900">{{ issue.title }}</h1>
        {% endif %}
    </div>

    {% if headerPlace and headerPlace.hint %}
        <twig:Ui:Callout tone="blue" size="sm" class="mt-4">{{ headerPlace.hint }}</twig:Ui:Callout>
    {% endif %}

</div>
