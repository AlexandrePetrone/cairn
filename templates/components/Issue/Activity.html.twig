{# Thread and comment editor of the issue page. The comment being written is the `body` prop, kept across every redraw, including those `issue:changed` triggers.
   The controls are plain HTML: a data-model attribute on a nested component would bind that component instead. #}
{% set activityDetail = this.detail %}
{% set activityTransitions = this.transitions %}
{% set activityCanComment = this.canComment %}
{% set activityEditable = this.editableComments %}
{% set activityPendingFiles = this.pendingFiles %}
{% set activityEditorUrls = editor_urls(issue.project) %}
<div {{ attributes }}>

    <section class="mt-8">
        <h2 class="font-semibold text-gray-900 mb-3">{{ 'issue.show.activity'|trans }}</h2>
        <ol class="relative border-l border-gray-200 ml-3 space-y-4">
            {% for entry in activityDetail.timeline %}
                {% set entryComment = entry.comment %}
                {% if entry.event %}
                    <twig:Issue:JournalEntry :entry="entry.event" />
                {% endif %}
                {% if entryComment %}
                    <li class="relative pl-6">
                        <span class="absolute -left-3 top-1"><twig:Ui:Avatar :name="entryComment.author.fullName" :kind="entryComment.author.internal ? 'internal' : 'external'" /></span>
                        {% set commentEditable = entryComment.id in activityEditable %}
                        <div class="group rounded-lg border p-3 {{ entryComment.private ? 'border-amber-200 border-l-4 border-l-amber-400 bg-amber-50/70 private-hatching' : 'border-gray-200 bg-white' }}">
                            <div class="flex items-center gap-2 text-xs">
                                <span class="font-medium text-gray-900">{{ entryComment.author.fullName }}</span>
                                <span class="text-gray-400">{{ entryComment.createdAt|date('d/m/Y H:i') }}</span>
                                {% if entryComment.editedAt %}<span class="text-gray-400 italic">· {{ 'issue.comment.edited'|trans({ '%date%': entryComment.editedAt|date('d/m/Y H:i') }) }}</span>{% endif %}
                                {% if entryComment.private %}<twig:Ui:Badge tone="amber" size="sm" icon="lock" class="ml-auto">{{ 'issue.comment.private_badge'|trans }}</twig:Ui:Badge>{% endif %}
                                {% if commentEditable and editingCommentId != entryComment.id and deletingCommentId != entryComment.id %}
                                    <span class="hover-actions -my-1 -mr-1 flex items-center {{ entryComment.private ? '' : 'ml-auto' }}">
                                        <twig:Ui:IconButton icon="pencil" size="sm" :label="'issue.comment.edit'|trans" data-action="live#action" data-live-action-param="editComment" data-live-id-param="{{ entryComment.id }}" />
                                        <twig:Ui:IconButton icon="trash-2" size="sm" tone="danger" :label="'issue.comment.delete'|trans" data-action="live#action" data-live-action-param="confirmDelete" data-live-id-param="{{ entryComment.id }}" />
                                    </span>
                                {% endif %}
                            </div>
                            {% if editingCommentId == entryComment.id %}
                                {# ⌘/Ctrl Enter saves (autosubmit), Esc cancels. #}
                                <form class="mt-2" data-controller="autosubmit" data-action="live#action:prevent" data-live-action-param="saveComment">
                                    <twig:Ui:Form:Editor model="norender|commentBody" :rows="3" autofocus class="mt-0"
                                                         :issuesUrl="activityEditorUrls.issues" :usersUrl="activityEditorUrls.users" :uploadUrl="activityEditorUrls.upload"
                                                         data-action="editor:submit->autosubmit#submit editor:cancel->live#action" data-live-action-param="cancelComment">{{ commentBody }}</twig:Ui:Form:Editor>
                                    {% set editPendingFiles = this.editPendingFiles %}
                                    {% if editPendingFiles is not empty %}
                                        <div class="mt-2 flex flex-wrap gap-2">
                                            {% for file in editPendingFiles %}
                                                <twig:Ui:Attachment :name="file.filename" :size="file.size" :image="file.image" :href="attachment_url(file)" class="bg-white py-1">
                                                    <twig:block name="actions">
                                                        <twig:Ui:IconButton icon="x" size="sm" :label="'attachment.remove'|trans" class="-mr-1" data-action="live#action" data-live-action-param="discard" data-live-uuid-param="{{ file.uuid.toRfc4122 }}" />
                                                    </twig:block>
                                                </twig:Ui:Attachment>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                    <div class="mt-2 flex flex-wrap items-center gap-2">
                                        <twig:Ui:Button variant="primary" size="sm" type="submit" data-loading="addAttribute(disabled)">{{ 'issue.edit.save'|trans }}</twig:Ui:Button>
                                        <twig:Ui:Button variant="ghost" size="sm" data-action="live#action" data-live-action-param="cancelComment">{{ 'issue.edit.cancel'|trans }}</twig:Ui:Button>
                                        <label title="{{ 'attachment.attach'|trans }}" class="inline-flex cursor-pointer items-center rounded p-1 text-gray-500 hover:bg-gray-100 hover:text-gray-800" data-loading="action(attach)|addClass(opacity-50)">
                                            {{ ux_icon('lucide:paperclip', { class: 'h-4 w-4' }) }}
                                            <span class="sr-only">{{ 'attachment.attach'|trans }}</span>
                                            <input type="file" name="files[]" multiple class="sr-only" data-controller="file-picker"
                                                   data-action="change->file-picker#chosen file-picker:chosen->live#action" data-live-action-param="files|attach">
                                        </label>
                                        <span class="ml-auto text-xs text-gray-400">{{ 'issue.comment.edit_hint'|trans }}</span>
                                    </div>
                                </form>
                            {% else %}
                            {% if deletingCommentId == entryComment.id %}
                                <div class="mt-2 flex flex-wrap items-center gap-2 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800" role="alertdialog">
                                    <span>{{ 'issue.comment.delete_confirm'|trans }}</span>
                                    <span class="ml-auto flex items-center gap-2">
                                        <twig:Ui:Button variant="danger" size="sm" data-action="live#action" data-live-action-param="deleteComment" data-loading="addAttribute(disabled)">{{ 'issue.comment.delete_yes'|trans }}</twig:Ui:Button>
                                        <twig:Ui:Button variant="ghost" size="sm" data-action="live#action" data-live-action-param="cancelDelete">{{ 'issue.edit.cancel'|trans }}</twig:Ui:Button>
                                    </span>
                                </div>
                            {% endif %}
                            <div class="prose prose-sm mt-1.5 max-w-none">{{ entryComment.body|markdown }}</div>
                            {% set commentFiles = activityDetail.commentAttachments(entryComment) %}
                            {% if commentFiles is not empty %}
                                <div class="mt-2 flex flex-wrap gap-2">
                                    {% for file in commentFiles %}
                                        <twig:Ui:Attachment :name="file.filename" :size="file.size" :image="file.image" :href="attachment_url(file)" class="bg-white">
                                            <twig:block name="actions">
                                                {% if commentEditable %}
                                                    <twig:Ui:IconButton icon="x" size="sm" :label="'attachment.remove'|trans" class="-mr-1" data-action="live#action" data-live-action-param="removeAttachment" data-live-uuid-param="{{ file.uuid.toRfc4122 }}" data-live-name-param="{{ file.filename }}" />
                                                {% endif %}
                                            </twig:block>
                                        </twig:Ui:Attachment>
                                    {% endfor %}
                                </div>
                            {% endif %}
                            {% endif %}
                        </div>
                    </li>
                {% endif %}
            {% endfor %}
        </ol>
        <div class="mt-6">
            {% if activityTransitions is not empty or activityCanComment %}
                {% if error %}
                    <twig:Ui:Callout tone="danger" size="sm" role="alert" class="mb-2">{{ error }}</twig:Ui:Callout>
                {% endif %}
                <div class="rounded-lg border border-gray-300 bg-white shadow-sm focus-within:border-indigo-400 {{ private ? 'border-amber-400 bg-amber-50 private-hatching' }}">
                    {% if activityCanComment %}
                        {# ⌘/Ctrl Enter posts; a posted comment empties the editor through editor:reset. #}
                        <twig:Ui:Form:Editor model="norender|body" :rows="3"
                                             class="mt-0 rounded-t-lg rounded-b-none border-0 bg-transparent focus-within:ring-0"
                                             :placeholder="'issue.comment.placeholder'|trans"
                                             :issuesUrl="activityEditorUrls.issues" :usersUrl="activityEditorUrls.users" :uploadUrl="activityEditorUrls.upload"
                                             data-action="editor:submit->live#action editor:reset@window->editor#reset" data-live-action-param="postComment">{{ body }}</twig:Ui:Form:Editor>
                        {% if activityPendingFiles is not empty %}
                            <div class="flex flex-wrap gap-2 px-3 pb-2">
                                {% for file in activityPendingFiles %}
                                    <twig:Ui:Attachment :name="file.filename" :size="file.size" :image="file.image" :href="attachment_url(file)" class="bg-white py-1">
                                        <twig:block name="actions">
                                            <twig:Ui:IconButton icon="x" size="sm" :label="'attachment.remove'|trans" class="-mr-1" data-action="live#action" data-live-action-param="discard" data-live-uuid-param="{{ file.uuid.toRfc4122 }}" />
                                        </twig:block>
                                    </twig:Ui:Attachment>
                                {% endfor %}
                            </div>
                        {% endif %}
                    {% endif %}
                    <div class="flex flex-wrap items-center gap-2 border-t border-gray-200 px-3 py-2">
                        {% if activityCanComment %}
                            <label title="{{ 'attachment.attach'|trans }}" class="inline-flex cursor-pointer items-center gap-1 rounded p-1 text-xs text-gray-500 hover:bg-gray-100 hover:text-gray-800" data-loading="action(attach)|addClass(opacity-50)">
                                {{ ux_icon('lucide:paperclip', { class: 'h-4 w-4' }) }}
                                <span class="sr-only">{{ 'attachment.attach'|trans }}</span>
                                <input type="file" name="files[]" multiple class="sr-only" data-controller="file-picker"
                                       data-action="change->file-picker#chosen file-picker:chosen->live#action" data-live-action-param="files|attach">
                            </label>
                        {% endif %}
                        {% if activityCanComment and this.canMakePrivate %}
                            <label class="inline-flex items-center gap-1.5 text-xs text-gray-600 cursor-pointer select-none">
                                <input type="checkbox" data-model="private" {{ private ? 'checked' }} class="h-3.5 w-3.5 rounded border-gray-300 text-amber-600">
                                <twig:ux:icon name="lucide:lock" class="h-3 w-3" />
                                {{ 'issue.comment.private'|trans }}
                            </label>
                        {% endif %}
                        <div class="ml-auto flex flex-wrap items-center gap-2">
                            {% if activityCanComment %}
                                <twig:Ui:Button data-action="live#action" data-live-action-param="postComment" data-loading="addAttribute(disabled)">{{ (private ? 'issue.comment.submit_private' : 'issue.comment.submit')|trans }}</twig:Ui:Button>
                            {% endif %}
                            {% if activityCanComment and activityTransitions is not empty %}<span class="h-5 w-px bg-gray-200"></span>{% endif %}
                            {% for transition in activityTransitions %}
                                <twig:Ui:Button :variant="transition.style.value == 'default' ? 'secondary' : transition.style.value" data-action="live#action" data-live-action-param="apply" data-live-transition-param="{{ transition.id }}" data-loading="addAttribute(disabled)">{{ transition.label }}</twig:Ui:Button>
                            {% endfor %}
                        </div>
                    </div>
                    {% if activityTransitions is not empty %}
                        <div class="flex items-center gap-2 border-t border-gray-100 bg-gray-50 px-3 py-1.5 text-xs text-gray-500 rounded-b-lg">
                            <twig:Ui:Status:Dot :status="issue.status.value" />
                            {{ 'issue.transition.hint'|trans({ '%place%': issue_place(issue) }) }}
                        </div>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </section>
</div>
