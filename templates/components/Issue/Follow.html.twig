{# The one notification setting: follow the issue, or stop. `this` is read before the nested components. #}
{% set followFollowing = this.following %}
<div {{ attributes }} data-loading="addClass(opacity-60)">
    {% if followFollowing %}
        <twig:Ui:Button size="sm" icon="bell-off" title="{{ 'issue.follow.following_help'|trans }}" data-action="live#action" data-live-action-param="unfollow" data-loading="addAttribute(disabled)">{{ 'issue.follow.unfollow'|trans }}</twig:Ui:Button>
    {% else %}
        <twig:Ui:Button size="sm" icon="bell" title="{{ 'issue.follow.follow_help'|trans }}" data-action="live#action" data-live-action-param="follow" data-loading="addAttribute(disabled)">{{ 'issue.follow.follow'|trans }}</twig:Ui:Button>
    {% endif %}
    {% if error %}<twig:Ui:Callout tone="danger" size="sm" role="alert" class="mt-2">{{ error }}</twig:Ui:Callout>{% endif %}
</div>
