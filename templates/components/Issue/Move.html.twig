{# The "⋯" menu of the issue page and its "Move…" dialog; empty for whoever may neither force a place nor change the tracker. `this` is read before any nested component. #}
{% set moveCan = this.canMove %}
<div {{ attributes }}>
    {% if moveCan %}
        <twig:Ui:Dropdown align="right" width="sm">
            <twig:block name="trigger">
                <twig:Ui:IconButton icon="ellipsis" :label="'issue.menu.more'|trans" data-action="dropdown#toggle" aria-expanded="false" aria-haspopup="menu" />
            </twig:block>
            <twig:Ui:Dropdown:Item icon="workflow" data-action="live#action" data-live-action-param="open">{{ 'issue.menu.move'|trans }}</twig:Ui:Dropdown:Item>
        </twig:Ui:Dropdown>
        {% if open %}
            {% set moveTrackers = this.trackers %}
            {% set moveTracker = this.tracker %}
            {% set movePlaces = this.places %}
            {% set moveOffPath = this.isOffPath %}
            {% set movePlaceLabel = this.placeLabel %}
            {% set moveChangesTracker = this.canChangeTracker %}
            {% set moveUnchanged = this.isSameTracker and placeId == issue.place %}
            <twig:Ui:Dialog :title="'issue.move.title'|trans({ '%key%': issue.key })" closeAction="cancel">
                <twig:block name="description"><p class="truncate">{{ issue.title }}</p></twig:block>
                {% if moveChangesTracker %}
                    <label class="block text-sm text-body">{{ 'issue.move.tracker'|trans }}
                        <twig:Ui:Form:Select model="trackerId">
                            {% for tracker in moveTrackers %}
                                <option value="{{ tracker.id }}" {{ moveTracker and tracker.id == moveTracker.id ? 'selected' }}>{{ tracker.name }}</option>
                            {% endfor %}
                        </twig:Ui:Form:Select>
                    </label>
                {% endif %}
                <label class="block text-sm text-body">{{ 'issue.move.place'|trans }}
                    <twig:Ui:Form:Select model="placeId">
                        {% for place in movePlaces %}
                            <option value="{{ place.id }}" {{ place.id == placeId ? 'selected' }}>{{ place.label }}</option>
                        {% endfor %}
                    </twig:Ui:Form:Select>
                </label>
                {% if moveOffPath %}
                    <twig:Ui:Callout tone="amber" size="sm">{{ 'issue.move.no_transition'|trans({ '%from%': issue_place(issue), '%to%': movePlaceLabel }) }}</twig:Ui:Callout>
                {% endif %}
                {% if error %}<twig:Ui:Callout tone="danger" size="sm" role="alert">{{ error }}</twig:Ui:Callout>{% endif %}
                <twig:block name="footer">
                    {# Nothing to do while the issue stays where it is; the handler refuses it too. #}
                    <twig:Ui:Button variant="primary" :disabled="moveUnchanged" data-action="live#action" data-live-action-param="confirm" data-loading="addAttribute(disabled)">{{ 'issue.move.submit'|trans }}</twig:Ui:Button>
                    <twig:Ui:Button variant="ghost" data-action="live#action" data-live-action-param="cancel">{{ 'issue.edit.cancel'|trans }}</twig:Ui:Button>
                </twig:block>
            </twig:Ui:Dialog>
        {% endif %}
    {% endif %}
</div>
