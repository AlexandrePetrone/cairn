{# An issue list: its filters, the selection bar when rows are checked, the rows and the pager. The page around it sets the scope and the filters offered. #}
{# Inside the blocks of nested components `this` is that component: they read `listComponent`. #}
{% set listComponent = this %}
{% set listIssues = computed.issues %}
<div {{ attributes.defaults({ class: 'flex flex-col' }) }}>
    <div class="border-b border-gray-200 bg-white px-4 sm:px-6 py-3 space-y-3">
        {{ include('issue/_filters.html.twig') }}
    </div>
    <div class="px-4 sm:px-6 py-4 space-y-3">
        {{ include('issue/_selection.html.twig') }}
        {{ include('issue/_list.html.twig') }}
    </div>
</div>
