{% extends 'layout/app.html.twig' %}

{% block page_title %}{{ 'nav.home'|trans }}{% endblock %}

{% block content %}
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 space-y-6">
        <div class="flex items-center gap-3">
            <twig:User:Avatar :user="app.user" size="2xl" />
            <div>
                <h1 class="text-xl font-semibold text-strong">{{ 'home.greeting'|trans({ '%name%': app.user.firstName }) }}</h1>
                <div class="text-xs text-muted">{{ 'home.assigned_count'|trans({ '%count%': assigned.total }) }}</div>
            </div>
        </div>

        <section>
            <div class="mb-2 flex items-center gap-2">
                <h2 class="font-semibold text-strong">{{ 'home.projects.title'|trans }}</h2>
                <span class="text-xs text-faint">{{ 'home.projects.hint'|trans }}</span>
                <a href="{{ path('app_projects') }}" class="ml-auto text-xs text-brand hover:underline">{{ 'home.projects.all'|trans }}</a>
            </div>
            {% if projects is empty %}
                <twig:Ui:EmptyState :title="'home.projects.empty'|trans" icon="folders" bordered>{{ 'home.projects.empty_hint'|trans }}</twig:Ui:EmptyState>
            {% else %}
                <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
                    {% for summary in projects %}
                        <twig:Ui:ProjectCard
                            href="{{ path('app_project_issues', { workspaceKey: summary.project.workspace.key, projectKey: summary.project.key }) }}"
                            :code="summary.project.issuePrefix" :name="summary.project.name" :workspace="summary.project.workspace.name"
                            :open="summary.open" :waiting="summary.waiting" :blocking="summary.blocking" />
                    {% endfor %}
                </div>
            {% endif %}
        </section>

        {% if waiting is not empty or blocking is not empty %}
            <section class="rounded-lg border border-amber-line bg-amber-soft/60">
                <h2 class="px-4 pt-3 pb-2 text-sm font-semibold text-amber">{{ 'home.signals.title'|trans }}</h2>
                <ul class="divide-y divide-amber-line border-t border-amber-line bg-surface rounded-b-lg">
                    {% for issue in blocking %}{{ include('issue/_row.html.twig', { reason: 'home.signals.blocking'|trans }) }}{% endfor %}
                    {% for issue in waiting %}{{ include('issue/_row.html.twig', { reason: 'home.signals.waiting'|trans }) }}{% endfor %}
                </ul>
            </section>
        {% endif %}

        {% for list in [
            { title: 'nav.issues.assigned'|trans, issues: assigned, href: path('app_my_issues_assigned') },
            { title: 'nav.issues.created'|trans, issues: created, href: path('app_my_issues_created') },
        ] %}
            <twig:Ui:Panel :title="list.title" :count="list.issues.total" :href="list.issues.total > 0 ? list.href : null">
                {% if list.issues.items is empty %}
                    <twig:Ui:EmptyState :title="'home.issues_empty'|trans" size="sm" />
                {% else %}
                    <ul class="divide-y divide-line-subtle">
                        {% for issue in list.issues.items|slice(0, 6) %}{{ include('issue/_row.html.twig', { reason: null }) }}{% endfor %}
                    </ul>
                {% endif %}
            </twig:Ui:Panel>
        {% endfor %}
    </div>
{% endblock %}
