{# The page of a workflow: its steps in the order of the kanban, its actions and the fields it asks for, each arranged in place and changed in a dialog; then its diagram and the categories that follow it. `dialog` says which dialog the address opens. #}
{% extends 'admin/configuration/base.html.twig' %}

{% set configurationSubject = 'workflows' %}

{% block configuration_actions %}
    <twig:Ui:Button size="sm" icon="settings" href="{{ path('app_admin_configuration_workflow_edit', { id: workflow.id }) }}" data-turbo-frame="modal">{{ 'admin.configuration.workflow.settings'|trans }}</twig:Ui:Button>
{% endblock %}

{% block configuration_content %}
    {% set workflowPlaces = definition.placesOf(workflow) %}
    <nav class="flex flex-wrap gap-x-5 border-b border-line" aria-label="{{ 'admin.configuration.nav.workflows'|trans }}">
        {% for other in definition.workflows %}
            <twig:Ui:Tab href="{{ path('app_admin_configuration_workflow', { id: other.id }) }}" :active="other.id == workflow.id">{{ other.label }}</twig:Ui:Tab>
        {% endfor %}
    </nav>

    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <h2 class="text-lg font-semibold text-strong">{{ workflow.label }} <span class="font-mono text-xs font-normal text-faint">{{ workflow.id }}</span></h2>
        <p class="text-sm text-muted">{{ 'admin.configuration.workflow.initial'|trans({ '%place%': definition.place(workflow.initial).label }) }}</p>
    </div>

    <div class="grid gap-5 lg:grid-cols-5">
        <div class="space-y-5 lg:col-span-2">
            <twig:Ui:Panel>
                <twig:block name="header">
                    <h3 class="font-semibold text-strong">{{ 'admin.configuration.workflow.steps'|trans }}</h3>
                    <span class="text-xs text-faint">{{ workflow.places|length }}</span>
                    <twig:Ui:Button size="sm" icon="plus" class="ml-auto" href="{{ path('app_admin_configuration_workflow_place_add', { id: workflow.id }) }}" data-turbo-frame="modal">{{ 'admin.configuration.workflow.add_place'|trans }}</twig:Ui:Button>
                </twig:block>
                <twig:block name="content"><twig:Config:Order kind="workflow_places" :workflow="workflow.id" /></twig:block>
                <twig:block name="footer">{{ 'admin.configuration.workflow.steps_intro'|trans }}</twig:block>
            </twig:Ui:Panel>

            <twig:Ui:Panel :title="'admin.configuration.workflow.fields'|trans" :count="workflow.fields|length">
                <twig:block name="content"><twig:Config:WorkflowFields :workflow="workflow.id" /></twig:block>
                <twig:block name="footer">{{ 'admin.configuration.workflow.fields_intro'|trans }}</twig:block>
            </twig:Ui:Panel>
        </div>

        <twig:Ui:Panel class="lg:col-span-3 self-start">
            <twig:block name="header">
                <h3 class="font-semibold text-strong">{{ 'admin.configuration.workflow.actions'|trans }}</h3>
                <span class="text-xs text-faint">{{ workflow.transitions|length }}</span>
                <twig:Ui:Button size="sm" icon="plus" class="ml-auto" href="{{ path('app_admin_configuration_transition_new', { id: workflow.id }) }}" data-turbo-frame="modal">{{ 'admin.configuration.action.new'|trans }}</twig:Ui:Button>
            </twig:block>
            <twig:block name="content"><twig:Config:Order kind="transitions" :workflow="workflow.id" :empty="'admin.configuration.workflow.no_action'|trans" /></twig:block>
            <twig:block name="footer">{{ 'admin.configuration.workflow.actions_intro'|trans }}</twig:block>
        </twig:Ui:Panel>
    </div>

    <twig:Workflow:Diagram :workflow="workflow" />

    <section class="space-y-2">
        <h3 class="font-semibold text-strong">{{ 'admin.configuration.workflow.usage'|trans }}</h3>
        {% if usage.trackers is empty %}
            <p class="text-sm text-muted">{{ 'admin.configuration.workflow.unused'|trans }}</p>
        {% else %}
            <div class="overflow-x-auto rounded-lg border border-line bg-surface">
                <table class="w-full text-sm">
                    <thead class="bg-subtle text-[11px] uppercase tracking-wider text-muted">
                        <tr>
                            <th class="px-4 py-2 text-left font-medium">{{ 'admin.configuration.workflow.tracker'|trans }}</th>
                            {% for place in workflowPlaces %}<th class="px-3 py-2 text-right font-medium whitespace-nowrap">{{ place.label }}</th>{% endfor %}
                            <th class="px-4 py-2 text-right font-medium">{{ 'admin.configuration.workflow.total'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line-subtle">
                        {% for tracker in usage.trackers %}
                            <tr>
                                <td class="px-4 py-2 whitespace-nowrap">
                                    <a href="{{ path('app_project_issues_tracker', { workspaceKey: tracker.project.workspace.key, projectKey: tracker.project.key, tracker: tracker.id }) }}" class="text-strong hover:text-brand">{{ tracker.name }}</a>
                                    {% if tracker.private %}<twig:ux:icon name="lucide:lock" class="inline h-3 w-3 text-faint" />{% endif %}
                                    <span class="block text-xs text-muted">{{ tracker.project.issuePrefix }} · {{ tracker.project.name }}</span>
                                </td>
                                {% for place in workflowPlaces %}
                                    {% set placeCount = usage.count(tracker, place.id) %}
                                    <td class="px-3 py-2 text-right tabular-nums {{ placeCount ? 'text-strong' : 'text-ghost' }}">{{ placeCount }}</td>
                                {% endfor %}
                                <td class="px-4 py-2 text-right tabular-nums font-medium text-strong">{{ usage.total(tracker) }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
{% endblock %}

{% block modal %}
    {% set modalClose = path('app_admin_configuration_workflow', { id: workflow.id }) %}
    {% if dialog == 'workflow' %}
        {{ include('admin/configuration/_dialog.html.twig', {
            title: workflow.label,
            closeHref: modalClose,
            submitLabel: 'admin.configuration.save'|trans,
            deleteAction: path('app_admin_configuration_workflow_delete', { id: workflow.id }),
            deleteHelp: 'admin.configuration.workflows.delete_help'|trans,
        }) }}
    {% elseif dialog == 'place_add' %}
        {{ include('admin/configuration/_dialog.html.twig', {
            title: 'admin.configuration.workflow.add_place'|trans,
            closeHref: modalClose,
            submitLabel: 'admin.configuration.workflow.add'|trans,
        }) }}
    {% elseif dialog == 'place_remove' %}
        {% set modalNote %}
            <div class="mt-4 space-y-3 text-sm">
                {% if dialogStanding > 0 %}
                    <twig:Ui:Callout tone="amber" size="sm">{{ 'admin.configuration.workflow.remove.standing'|trans({ '%count%': dialogStanding }) }}</twig:Ui:Callout>
                {% endif %}
                {% if dialogDeleted is not empty or dialogChanged is not empty %}
                    <div>
                        <h3 class="font-medium text-strong">{{ 'admin.configuration.workflow.remove.changes'|trans }}</h3>
                        <ul class="mt-1 divide-y divide-line-subtle rounded-lg border border-line">
                            {% for action in dialogDeleted %}
                                <li class="px-3 py-2"><span class="font-medium text-red">{{ 'admin.configuration.workflow.remove.deleted'|trans }}</span> · {{ action }}</li>
                            {% endfor %}
                            {% for action in dialogChanged %}
                                <li class="px-3 py-2"><span class="font-medium text-amber">{{ 'admin.configuration.workflow.remove.changed'|trans }}</span> · {{ action }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
                <p class="text-xs text-muted">{{ 'admin.configuration.workflow.remove.kept'|trans }}</p>
            </div>
        {% endset %}
        {{ include('admin/configuration/_dialog.html.twig', {
            title: 'admin.configuration.workflow.remove.title'|trans({ '%place%': dialogPlace.label, '%workflow%': workflow.label }),
            closeHref: modalClose,
            submitLabel: 'admin.configuration.workflow.remove.submit'|trans({ '%count%': dialogStanding }),
            note: modalNote,
        }) }}
    {% elseif dialog == 'transition' %}
        {{ include('admin/configuration/_dialog.html.twig', {
            title: (dialogTransition ?? null) ? dialogTransition.label : 'admin.configuration.action.new'|trans,
            closeHref: modalClose,
            submitLabel: ((dialogTransition ?? null) ? 'admin.configuration.save' : 'admin.configuration.create')|trans,
            deleteAction: (dialogTransition ?? null) ? path('app_admin_configuration_transition_delete', { id: workflow.id, key: dialogTransition.id }) : null,
            deleteHelp: 'admin.configuration.action.delete_help'|trans,
            size: 'lg',
        }) }}
    {% else %}
        {{ include('project/_form_dialog.html.twig', { form: null }) }}
    {% endif %}
{% endblock %}
