{% extends 'admin/configuration/base.html.twig' %}

{% set configurationSubject = 'workflows' %}

{% block configuration_content %}
    {% set workflowPlaces = definition.placesOf(workflow) %}
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <a href="{{ path('app_admin_configuration_workflows', { _fragment: workflow.id }) }}" class="text-xs text-muted hover:text-strong">← {{ 'admin.configuration.nav.workflows'|trans }}</a>
        <h2 class="text-lg font-semibold text-strong">{{ workflow.label }} <span class="font-mono text-xs font-normal text-faint">{{ workflow.id }}</span></h2>
    </div>
    <p class="text-sm text-muted">
        {{ 'admin.configuration.workflow.initial'|trans({ '%place%': definition.place(workflow.initial).label }) }}
        {% if workflow.fallbackPlace %}{{ 'admin.configuration.workflow.fallback'|trans({ '%place%': definition.place(workflow.fallbackPlace).label }) }}{% endif %}
    </p>

    <twig:Workflow:Diagram :workflow="workflow" />

    <section class="space-y-2">
        <h3 class="font-semibold text-strong">{{ 'admin.configuration.workflow.steps'|trans }}</h3>
        <p class="text-xs text-muted">{{ 'admin.configuration.workflow.steps_intro'|trans }}</p>
        <ol class="space-y-3">
            {% for place in workflowPlaces %}
                {% set placeActions = workflow.transitionsFrom(place.id) %}
                <li class="rounded-lg border border-line bg-surface">
                    <div class="flex flex-wrap items-center gap-2 px-4 py-2.5 border-b border-line-subtle">
                        <span class="text-xs text-faint tabular-nums">{{ loop.index }}</span>
                        <twig:Ui:Status:Step :status="place.status.value" :label="place.label" withStatus class="font-medium" />
                        {% if place.id == workflow.initial %}<twig:Ui:Badge tone="indigo" size="sm">{{ 'admin.configuration.workflow.initial_badge'|trans }}</twig:Ui:Badge>{% endif %}
                        {% if placeActions is empty %}<twig:Ui:Badge size="sm">{{ 'admin.configuration.workflow.final_badge'|trans }}</twig:Ui:Badge>{% endif %}
                        <span class="ml-auto font-mono text-[11px] text-faint">{{ place.id }}</span>
                    </div>
                    {% if placeActions is not empty %}
                        <ul class="divide-y divide-line-subtle">
                            {% for transition in placeActions %}
                                <li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-2 text-sm">
                                    <span class="font-medium {{ transition.style.value == 'danger' ? 'text-red' : (transition.style.value == 'primary' ? 'text-brand' : 'text-strong') }}">{{ transition.label }}</span>
                                    <span class="text-muted">→ {{ definition.place(transition.to).label }}</span>
                                    {% if transition.requiresComment %}
                                        <span class="inline-flex items-center gap-1 text-xs text-amber" title="{{ transition.commentPrompt }}"><twig:ux:icon name="lucide:message-square" class="h-3.5 w-3.5" />{{ 'admin.configuration.workflow.comment_required'|trans }}</span>
                                    {% endif %}
                                    <span class="sm:ml-auto flex flex-wrap gap-1">
                                        {% for roleId in transition.roles %}
                                            <twig:Ui:Badge size="sm">{{ definition.roles[roleId].label ?? roleId }}</twig:Ui:Badge>
                                        {% endfor %}
                                    </span>
                                    {% if transition.description %}<span class="basis-full text-xs text-muted">{{ transition.description }}</span>{% endif %}
                                    {% if transition.commentPrompt %}<span class="basis-full text-xs text-muted">{{ 'admin.configuration.workflow.comment_prompt'|trans({ '%prompt%': transition.commentPrompt }) }}</span>{% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </li>
            {% endfor %}
        </ol>
    </section>

    <section class="space-y-2">
        <h3 class="font-semibold text-strong">{{ 'admin.configuration.workflow.fields'|trans }}</h3>
        {% if workflow.fields is empty %}
            <p class="text-sm text-muted">{{ 'admin.configuration.workflow.no_field'|trans }}</p>
        {% else %}
            <div class="overflow-x-auto rounded-lg border border-line bg-surface">
                <table class="w-full text-sm">
                    <thead class="bg-subtle text-[11px] uppercase tracking-wider text-muted">
                        <tr>
                            <th class="px-4 py-2 text-left font-medium">{{ 'admin.configuration.fields.field'|trans }}</th>
                            <th class="px-4 py-2 text-left font-medium">{{ 'admin.configuration.fields.type'|trans }}</th>
                            <th class="px-4 py-2 text-left font-medium">{{ 'admin.configuration.fields.filling'|trans }}</th>
                            <th class="px-4 py-2 text-left font-medium">{{ 'admin.configuration.fields.visibility'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line-subtle">
                        {% for fieldUsage in workflow.fields %}
                            {% set usageField = definition.fields[fieldUsage.field] %}
                            <tr>
                                <td class="px-4 py-2 text-strong">{{ usageField.label }}</td>
                                <td class="px-4 py-2 text-muted">
                                    {{ ('field_type.' ~ usageField.type.value)|trans }}
                                    {% if usageField.options is not empty %}<span class="block text-xs text-muted">{{ usageField.options|join(' · ') }}</span>{% endif %}
                                </td>
                                <td class="px-4 py-2">
                                    {% if fieldUsage.required %}<twig:Ui:Badge tone="amber" size="sm">{{ 'admin.configuration.fields.required'|trans }}</twig:Ui:Badge>{% else %}<span class="text-xs text-muted">{{ 'admin.configuration.fields.optional'|trans }}</span>{% endif %}
                                </td>
                                <td class="px-4 py-2">
                                    {% if usageField.internalOnly %}<twig:Ui:Badge size="sm" icon="lock">{{ 'admin.configuration.fields.internal_only'|trans }}</twig:Ui:Badge>{% else %}<span class="text-xs text-muted">{{ 'admin.configuration.fields.everyone'|trans }}</span>{% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>

    <section class="space-y-2">
        <h3 class="font-semibold text-strong">{{ 'admin.configuration.workflow.usage'|trans }}</h3>
        {% if usage.trackers is empty %}
            <p class="text-sm text-muted">{{ 'admin.configuration.workflow.unused'|trans }}</p>
        {% else %}
            <div class="overflow-x-auto rounded-lg border border-line bg-surface">
                <table class="w-full text-sm">
                    <thead class="bg-subtle text-[11px] uppercase tracking-wider text-muted">
                        <tr>
                            <th class="px-4 py-2 text-left font-medium">{{ 'admin.configuration.workflow.tracker'|trans }}</th>
                            {% for place in workflowPlaces %}<th class="px-3 py-2 text-right font-medium whitespace-nowrap">{{ place.label }}</th>{% endfor %}
                            <th class="px-4 py-2 text-right font-medium">{{ 'admin.configuration.workflow.total'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line-subtle">
                        {% for tracker in usage.trackers %}
                            <tr>
                                <td class="px-4 py-2 whitespace-nowrap">
                                    <a href="{{ path('app_project_issues_tracker', { workspaceKey: tracker.project.workspace.key, projectKey: tracker.project.key, tracker: tracker.id }) }}" class="text-strong hover:text-brand">{{ tracker.name }}</a>
                                    {% if tracker.private %}<twig:ux:icon name="lucide:lock" class="inline h-3 w-3 text-faint" />{% endif %}
                                    <span class="block text-xs text-muted">{{ tracker.project.issuePrefix }} · {{ tracker.project.name }}</span>
                                </td>
                                {% for place in workflowPlaces %}
                                    {% set placeCount = usage.count(tracker, place.id) %}
                                    <td class="px-3 py-2 text-right tabular-nums {{ placeCount ? 'text-strong' : 'text-ghost' }}">{{ placeCount }}</td>
                                {% endfor %}
                                <td class="px-4 py-2 text-right tabular-nums font-medium text-strong">{{ usage.total(tracker) }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
{% endblock %}
