{% extends 'admin/configuration/base.html.twig' %}

{% set configurationSubject = 'workflows' %}

{% block configuration_content %}
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <a href="{{ path('app_admin_configuration_workflows', { _fragment: workflow.id }) }}" class="text-xs text-gray-500 hover:text-gray-900">← {{ 'admin.configuration.nav.workflows'|trans }}</a>
        <h2 class="text-lg font-semibold text-gray-900">{{ workflow.label }} <span class="font-mono text-xs font-normal text-gray-400">{{ workflow.id }}</span></h2>
    </div>
    <p class="text-sm text-gray-600">
        {{ 'admin.configuration.workflow.initial'|trans({ '%place%': workflow.place(workflow.initial).label }) }}
        {% if workflow.fallbackPlace %}{{ 'admin.configuration.workflow.fallback'|trans({ '%place%': workflow.place(workflow.fallbackPlace).label }) }}{% endif %}
    </p>

    <twig:Workflow:Diagram :workflow="workflow" />

    <section class="space-y-2">
        <h3 class="font-semibold text-gray-900">{{ 'admin.configuration.workflow.steps'|trans }}</h3>
        <p class="text-xs text-gray-500">{{ 'admin.configuration.workflow.steps_intro'|trans }}</p>
        <ol class="space-y-3">
            {% for place in workflow.places %}
                {% set placeActions = workflow.transitionsFrom(place.id) %}
                <li class="rounded-lg border border-gray-200 bg-white">
                    <div class="flex flex-wrap items-center gap-2 px-4 py-2.5 border-b border-gray-100">
                        <span class="text-xs text-gray-400 tabular-nums">{{ loop.index }}</span>
                        <twig:Ui:Status:Step :status="place.status.value" :label="place.label" withStatus class="font-medium" />
                        {% if place.id == workflow.initial %}<twig:Ui:Badge tone="indigo" size="sm">{{ 'admin.configuration.workflow.initial_badge'|trans }}</twig:Ui:Badge>{% endif %}
                        {% if placeActions is empty %}<twig:Ui:Badge size="sm">{{ 'admin.configuration.workflow.final_badge'|trans }}</twig:Ui:Badge>{% endif %}
                        <span class="ml-auto font-mono text-[11px] text-gray-400">{{ place.id }}</span>
                    </div>
                    {% if place.hint %}<p class="px-4 pt-2 text-xs text-gray-600 italic">{{ place.hint }}</p>{% endif %}
                    {% if placeActions is not empty %}
                        <ul class="divide-y divide-gray-50">
                            {% for transition in placeActions %}
                                <li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-2 text-sm">
                                    <span class="font-medium {{ transition.style.value == 'danger' ? 'text-red-700' : (transition.style.value == 'primary' ? 'text-indigo-700' : 'text-gray-900') }}">{{ transition.label }}</span>
                                    <span class="text-gray-500">→ {{ workflow.place(transition.to).label }}</span>
                                    {% if transition.requiresComment %}
                                        <span class="inline-flex items-center gap-1 text-xs text-amber-800" title="{{ transition.commentPrompt }}"><twig:ux:icon name="lucide:message-square" class="h-3.5 w-3.5" />{{ 'admin.configuration.workflow.comment_required'|trans }}</span>
                                    {% endif %}
                                    <span class="sm:ml-auto flex flex-wrap gap-1">
                                        {% for roleId in transition.roles %}
                                            <twig:Ui:Badge size="sm">{{ definition.roles[roleId].label ?? roleId }}</twig:Ui:Badge>
                                        {% endfor %}
                                    </span>
                                    {% if transition.commentPrompt %}<span class="basis-full text-xs text-gray-500">« {{ transition.commentPrompt }} »</span>{% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </li>
            {% endfor %}
        </ol>
    </section>

    <section class="space-y-2">
        <h3 class="font-semibold text-gray-900">{{ 'admin.configuration.workflow.usage'|trans }}</h3>
        {% if usage.trackers is empty %}
            <p class="text-sm text-gray-500">{{ 'admin.configuration.workflow.unused'|trans }}</p>
        {% else %}
            <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white">
                <table class="w-full text-sm">
                    <thead class="bg-gray-50 text-[11px] uppercase tracking-wider text-gray-500">
                        <tr>
                            <th class="px-4 py-2 text-left font-medium">{{ 'admin.configuration.workflow.tracker'|trans }}</th>
                            {% for place in workflow.places %}<th class="px-3 py-2 text-right font-medium whitespace-nowrap">{{ place.label }}</th>{% endfor %}
                            <th class="px-4 py-2 text-right font-medium">{{ 'admin.configuration.workflow.total'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {% for tracker in usage.trackers %}
                            <tr>
                                <td class="px-4 py-2 whitespace-nowrap">
                                    <a href="{{ path('app_project_issues_tracker', { workspaceKey: tracker.project.workspace.key, projectKey: tracker.project.key, tracker: tracker.id }) }}" class="text-gray-900 hover:text-indigo-700">{{ tracker.name }}</a>
                                    {% if tracker.private %}<twig:ux:icon name="lucide:lock" class="inline h-3 w-3 text-gray-400" />{% endif %}
                                    <span class="block text-xs text-gray-500">{{ tracker.project.issuePrefix }} · {{ tracker.project.name }}</span>
                                </td>
                                {% for place in workflow.places %}
                                    {% set placeCount = usage.count(tracker, place.id) %}
                                    <td class="px-3 py-2 text-right tabular-nums {{ placeCount ? 'text-gray-900' : 'text-gray-300' }}">{{ placeCount }}</td>
                                {% endfor %}
                                <td class="px-4 py-2 text-right tabular-nums font-medium text-gray-900">{{ usage.total(tracker) }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
{% endblock %}
