{# The roles in their order, from the broadest to the narrowest, and the rights. A role is created and changed in a dialog; the rights are ticked in place. #}
{% extends 'admin/configuration/base.html.twig' %}

{% set configurationSubject = 'roles' %}

{% block configuration_actions %}
    <twig:Ui:Button variant="primary" size="sm" icon="plus" href="{{ path('app_admin_configuration_role_new') }}" data-turbo-frame="modal">{{ 'admin.configuration.roles.new'|trans }}</twig:Ui:Button>
{% endblock %}

{% block configuration_content %}
    {% if not definition.empty %}
        <twig:Ui:Panel :title="'admin.configuration.roles.title'|trans" :count="definition.roles|length">
            <twig:block name="content"><twig:Config:Order kind="roles" /></twig:block>
            <twig:block name="footer">{{ 'admin.configuration.roles.intro'|trans }}</twig:block>
        </twig:Ui:Panel>

        <section class="space-y-2">
            <h2 class="font-semibold text-strong">{{ 'admin.configuration.permissions.title'|trans }}</h2>
            <p class="text-xs text-muted">{{ 'admin.configuration.permissions.intro'|trans }}</p>
            <twig:Config:PermissionMatrix />
        </section>
    {% endif %}
{% endblock %}

{% block modal %}
    {# Freeing a role takes it out of its actions for good: said before it is done, with the rules left without anyone to trigger them. #}
    {% set modalNote = '' %}
    {% if (dialogLeaves.actions ?? []) is not empty %}
        {% set modalNote %}
            <twig:Ui:Callout tone="amber" size="sm" class="mt-4">
                <p>{{ 'admin.configuration.roles.leaves_actions'|trans({ '%count%': dialogLeaves.actions|length, '%actions%': dialogLeaves.actions|join(', ') }) }}</p>
                {% if dialogLeaves.rules is not empty %}
                    <p class="mt-2">{{ 'admin.configuration.roles.leaves_rules'|trans({ '%count%': dialogLeaves.rules|length }) }}</p>
                    <ul class="mt-1 list-disc pl-5">{% for rule in dialogLeaves.rules %}<li>{{ rule }}</li>{% endfor %}</ul>
                {% endif %}
            </twig:Ui:Callout>
        {% endset %}
    {% endif %}
    {{ include('admin/configuration/_dialog.html.twig', {
        note: modalNote,
        title: dialogRole ? dialogRole.label : 'admin.configuration.roles.new'|trans,
        closeHref: path('app_admin_configuration_roles'),
        submitLabel: (dialogRole ? 'admin.configuration.save' : 'admin.configuration.create')|trans,
        deleteAction: dialogRole ? path('app_admin_configuration_role_delete', { id: dialogRole.id }) : null,
        deleteHelp: 'admin.configuration.roles.delete_help'|trans,
        deleteRefusal: dialogRefusal ?? null,
    }) }}
{% endblock %}
