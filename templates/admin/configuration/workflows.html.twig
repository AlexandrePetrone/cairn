{% extends 'admin/configuration/base.html.twig' %}

{% set configurationSubject = 'workflows' %}

{% block configuration_content %}
    {% set workflowsCheck %}<twig:ux:icon name="lucide:check" class="mx-auto h-4 w-4 text-emerald-600" />{% endset %}
    {% set workflowsNone %}<span class="text-gray-300">·</span>{% endset %}
    <p class="text-sm text-gray-600">{{ 'admin.configuration.workflows.intro'|trans }}</p>

    {% for workflow in definition.workflows %}
        <section class="rounded-lg border border-gray-200 bg-white" id="{{ workflow.id }}">
            <header class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3 border-b border-gray-100 bg-gray-50/60 rounded-t-lg">
                <h2 class="text-base font-semibold text-gray-900">{{ workflow.label }}</h2>
                <span class="font-mono text-[11px] text-gray-400">{{ workflow.id }}</span>
                <span class="text-xs text-gray-500">{{ 'admin.configuration.workflows.tracker_count'|trans({ '%count%': trackers[workflow.id] ?? 0 }) }}</span>
                <a href="{{ path('app_admin_configuration_workflow', { id: workflow.id }) }}" class="ml-auto text-xs text-indigo-600 hover:underline">{{ 'admin.configuration.workflows.details'|trans }}</a>
            </header>

            <div class="p-4 space-y-5">
                <div class="space-y-2">
                    <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-400">{{ 'admin.configuration.workflows.graph'|trans }}</h3>
                    <twig:Workflow:Diagram :workflow="workflow" />
                </div>

                <div class="space-y-2">
                    <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-400">{{ 'admin.configuration.workflow.fields'|trans }}</h3>
                    {% if workflow.fields is empty %}
                        <p class="text-sm text-gray-500">{{ 'admin.configuration.workflow.no_field'|trans }}</p>
                    {% else %}
                        <div class="overflow-x-auto rounded-md border border-gray-200">
                            <table class="w-full text-sm">
                                <thead class="bg-gray-50 text-[11px] uppercase tracking-wider text-gray-500">
                                    <tr>
                                        <th class="px-3 py-2 text-left font-medium">{{ 'admin.configuration.fields.field'|trans }}</th>
                                        <th class="px-3 py-2 text-left font-medium">{{ 'admin.configuration.fields.type'|trans }}</th>
                                        <th class="px-3 py-2 text-left font-medium">{{ 'admin.configuration.fields.filling'|trans }}</th>
                                        <th class="px-3 py-2 text-left font-medium">{{ 'admin.configuration.fields.visibility'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100">
                                    {% for usage in workflow.fields %}
                                        {% set usageField = definition.fields[usage.field] %}
                                        <tr>
                                            <td class="px-3 py-2 text-gray-900">{{ usageField.label }}</td>
                                            <td class="px-3 py-2 text-gray-600">
                                                {{ ('field_type.' ~ usageField.type.value)|trans }}
                                                {% if usageField.options is not empty %}<span class="block text-xs text-gray-500">{{ usageField.options|join(' · ') }}</span>{% endif %}
                                            </td>
                                            <td class="px-3 py-2">
                                                {% if usage.required %}<twig:Ui:Badge tone="amber" size="sm">{{ 'admin.configuration.fields.required'|trans }}</twig:Ui:Badge>{% else %}<span class="text-xs text-gray-500">{{ 'admin.configuration.fields.optional'|trans }}</span>{% endif %}
                                            </td>
                                            <td class="px-3 py-2">
                                                {% if usageField.internalOnly %}<twig:Ui:Badge size="sm" icon="lock">{{ 'admin.configuration.fields.internal_only'|trans }}</twig:Ui:Badge>{% else %}<span class="text-xs text-gray-500">{{ 'admin.configuration.fields.everyone'|trans }}</span>{% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>

                <div class="space-y-2">
                    <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-400">{{ 'admin.configuration.workflows.actions'|trans }}</h3>
                    <div class="overflow-x-auto rounded-md border border-gray-200">
                        <table class="w-full text-sm">
                            <thead class="bg-gray-50 text-[11px] uppercase tracking-wider text-gray-500">
                                <tr>
                                    <th class="px-3 py-2 text-left font-medium min-w-56">{{ 'admin.configuration.workflows.action'|trans }}</th>
                                    <th class="px-3 py-2 text-left font-medium">{{ 'admin.configuration.workflows.from'|trans }}</th>
                                    <th class="px-3 py-2 text-left font-medium">{{ 'admin.configuration.workflows.to'|trans }}</th>
                                    {% for role in definition.roles %}<th class="px-3 py-2 text-center font-medium whitespace-nowrap">{{ role.label }}</th>{% endfor %}
                                    <th class="px-3 py-2 text-center font-medium whitespace-nowrap">{{ 'admin.user.type.admin'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100">
                                {% for transition in workflow.transitions %}
                                    <tr class="align-top">
                                        <td class="px-3 py-2">
                                            <span class="font-medium {{ transition.style.value == 'danger' ? 'text-red-700' : (transition.style.value == 'primary' ? 'text-indigo-700' : 'text-gray-900') }}">{{ transition.label }}</span>
                                            {% if transition.requiresComment %}
                                                <span class="mt-0.5 flex items-start gap-1 text-xs text-amber-800"><twig:ux:icon name="lucide:message-square" class="mt-0.5 h-3.5 w-3.5 shrink-0" />{{ transition.commentPrompt ?? 'admin.configuration.workflow.comment_required'|trans }}</span>
                                            {% endif %}
                                        </td>
                                        <td class="px-3 py-2 text-gray-600">{{ transition.from|map(f => workflow.place(f).label)|join(', ') }}</td>
                                        <td class="px-3 py-2 text-gray-900 whitespace-nowrap">{{ workflow.place(transition.to).label }}</td>
                                        {% for role in definition.roles %}<td class="px-3 py-2 text-center">{{ role.id in transition.roles ? workflowsCheck : workflowsNone }}</td>{% endfor %}
                                        <td class="px-3 py-2 text-center">{{ workflowsCheck }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </section>
    {% endfor %}
{% endblock %}
