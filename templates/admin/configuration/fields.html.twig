{% extends 'admin/configuration/base.html.twig' %}

{% set configurationSubject = 'fields' %}

{% block configuration_content %}
    <section class="space-y-2">
        <h2 class="font-semibold text-gray-900">{{ 'admin.configuration.fields.title'|trans }}</h2>
        <p class="text-xs text-gray-500">{{ 'admin.configuration.fields.intro'|trans }}</p>
        <div class="grid md:grid-cols-2 gap-4">
            {% for field in definition.fields %}
                <div class="rounded-lg border border-gray-200 bg-white p-4 space-y-2">
                    <div class="flex flex-wrap items-center gap-2">
                        <h3 class="font-medium text-gray-900">{{ field.label }}</h3>
                        <span class="text-xs text-gray-500">{{ ('field_type.' ~ field.type.value)|trans }}</span>
                        {% if field.internalOnly %}<twig:Ui:Badge size="sm" icon="lock">{{ 'admin.configuration.fields.internal_only'|trans }}</twig:Ui:Badge>{% endif %}
                        <span class="ml-auto font-mono text-[11px] text-gray-400">{{ field.id }}</span>
                    </div>
                    {% if field.help %}<p class="text-xs text-gray-600">{{ field.help }}</p>{% endif %}
                    {% if field.options is not empty %}
                        <div class="flex flex-wrap gap-1">
                            {% for optionLabel in field.options %}<twig:Ui:Badge>{{ optionLabel }}</twig:Ui:Badge>{% endfor %}
                        </div>
                    {% endif %}
                    <p class="text-xs text-gray-500">
                        {% set fieldWorkflows = definition.workflows|filter(wf => wf.fields[field.id] is defined) %}
                        {% if fieldWorkflows is empty %}
                            {{ 'admin.configuration.fields.unused'|trans }}
                        {% else %}
                            {{ 'admin.configuration.fields.used_by'|trans }}
                            {% for workflow in fieldWorkflows %}
                                <a href="{{ path('app_admin_configuration_workflow', { id: workflow.id }) }}" class="text-gray-700 hover:text-indigo-700">{{ workflow.label }}</a>{% if workflow.fields[field.id].required %} ({{ 'admin.configuration.fields.required'|trans|lower }}){% endif %}{{ not loop.last ? ', ' }}
                            {% endfor %}
                        {% endif %}
                    </p>
                </div>
            {% endfor %}
        </div>
    </section>

    <section class="space-y-2">
        <h2 class="font-semibold text-gray-900">{{ 'admin.configuration.links.title'|trans }}</h2>
        <p class="text-xs text-gray-500">{{ 'admin.configuration.links.intro'|trans }}</p>
        <ul class="rounded-lg border border-gray-200 bg-white divide-y divide-gray-100 text-sm">
            {% for link in definition.links %}
                <li class="flex flex-wrap items-center gap-2 px-4 py-2">
                    <span class="text-gray-900">{{ link.label }}</span>
                    {% if link.inverseLabel %}
                        <span class="text-xs text-gray-500">{{ 'admin.configuration.links.inverse'|trans({ '%label%': link.inverseLabel }) }}</span>
                    {% else %}
                        <span class="text-xs text-gray-500">{{ 'admin.configuration.links.symmetric'|trans }}</span>
                    {% endif %}
                    <span class="ml-auto font-mono text-[11px] text-gray-400">{{ link.id }}</span>
                </li>
            {% endfor %}
        </ul>
    </section>
{% endblock %}
