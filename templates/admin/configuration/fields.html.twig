{# The fields and the link types of the instance, each list in its order, created and changed in dialogs. #}
{% extends 'admin/configuration/base.html.twig' %}

{% set configurationSubject = 'fields' %}

{% block configuration_content %}
    {% if not definition.empty %}
        <twig:Ui:Panel>
            <twig:block name="header">
                <h2 class="font-semibold text-strong">{{ 'admin.configuration.fields.title'|trans }}</h2>
                <span class="text-xs text-faint">{{ definition.fields|length }}</span>
                <twig:Ui:Button size="sm" icon="plus" class="ml-auto" href="{{ path('app_admin_configuration_field_new') }}" data-turbo-frame="modal">{{ 'admin.configuration.fields.new'|trans }}</twig:Ui:Button>
            </twig:block>
            <twig:block name="content"><twig:Config:Order kind="fields" :empty="'admin.configuration.fields.empty'|trans" /></twig:block>
            <twig:block name="footer">{{ 'admin.configuration.fields.intro'|trans }}</twig:block>
        </twig:Ui:Panel>

        <twig:Ui:Panel>
            <twig:block name="header">
                <h2 class="font-semibold text-strong">{{ 'admin.configuration.links.title'|trans }}</h2>
                <span class="text-xs text-faint">{{ definition.links|length }}</span>
                <twig:Ui:Button size="sm" icon="plus" class="ml-auto" href="{{ path('app_admin_configuration_link_new') }}" data-turbo-frame="modal">{{ 'admin.configuration.links.new'|trans }}</twig:Ui:Button>
            </twig:block>
            <twig:block name="content"><twig:Config:Order kind="links" :empty="'admin.configuration.links.empty'|trans" /></twig:block>
            <twig:block name="footer">{{ 'admin.configuration.links.intro'|trans }}</twig:block>
        </twig:Ui:Panel>
    {% endif %}
{% endblock %}

{% block modal %}
    {% if dialogIsLink %}
        {{ include('admin/configuration/_dialog.html.twig', {
            title: dialogSubject ? dialogSubject.label : 'admin.configuration.links.new'|trans,
            closeHref: path('app_admin_configuration_fields'),
            submitLabel: (dialogSubject ? 'admin.configuration.save' : 'admin.configuration.create')|trans,
            deleteAction: dialogSubject ? path('app_admin_configuration_link_delete', { id: dialogSubject.id }) : null,
            deleteHelp: 'admin.configuration.links.delete_help'|trans,
        }) }}
    {% else %}
        {{ include('admin/configuration/_dialog.html.twig', {
            title: dialogSubject ? dialogSubject.label : 'admin.configuration.fields.new'|trans,
            closeHref: path('app_admin_configuration_fields'),
            submitLabel: (dialogSubject ? 'admin.configuration.save' : 'admin.configuration.create')|trans,
            deleteAction: dialogSubject ? path('app_admin_configuration_field_delete', { id: dialogSubject.id }) : null,
            deleteHelp: 'admin.configuration.fields.delete_help'|trans,
        }) }}
    {% endif %}
{% endblock %}
