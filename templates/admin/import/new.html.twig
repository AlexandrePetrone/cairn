{% extends 'layout/admin.html.twig' %}

{% block page_title %}{{ 'admin.import.new'|trans }}{% endblock %}

{% block breadcrumb %}
    <twig:ux:icon name="lucide:chevron-right" class="h-3 w-3 text-ghost shrink-0" />
    <a href="{{ path('app_admin_imports') }}" class="hover:text-strong">{{ 'admin.nav.imports'|trans }}</a>
{% endblock %}

{% block content %}
    <div class="max-w-2xl mx-auto px-4 sm:px-6 py-5 space-y-4">
        <h1 class="text-xl font-semibold text-strong">{{ 'admin.import.new'|trans }}</h1>
        <p class="text-sm text-muted">{{ 'admin.import.new_intro'|trans }} <a href="{{ path('app_admin_import_format') }}" class="text-brand hover:underline">{{ 'admin.import.format.link'|trans }}</a></p>
        {{ form_start(form, { attr: { class: 'rounded-lg border border-line bg-surface p-4 space-y-4' } }) }}
            {{ form_errors(form) }}
            {{ form_row(form.upload, { help_translation_parameters: { '%limit%': uploadLimit } }) }}
            {{ form_row(form.archive) }}
            {{ form_row(form.project) }}
            <div class="flex flex-wrap items-center gap-2">
                <twig:Ui:Button type="submit" variant="primary" size="lg">{{ 'admin.import.analyse'|trans }}</twig:Ui:Button>
                <twig:Ui:Button variant="ghost" size="lg" href="{{ path('app_admin_imports') }}">{{ 'admin.cancel'|trans }}</twig:Ui:Button>
                <span class="text-xs text-muted">{{ 'admin.import.analyse_help'|trans }}</span>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
