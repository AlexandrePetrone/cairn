{% extends 'admin/template/base.html.twig' %}

{# The automation rules of a project template, those that react to an event then those that wait for time: each with its switch (how it will be in the projects made from the template), what it says in one sentence and where it applies. Nothing runs here. #}
{% block template_actions %}
    <twig:Ui:Button variant="primary" icon="plus" href="{{ path('app_admin_template_automation_new', { template: template.id }) }}">{{ 'automation.new'|trans }}</twig:Ui:Button>
{% endblock %}

{% block template_content %}
    <p class="text-xs text-muted">{{ 'admin.template.rule.intro'|trans }}</p>

    {% if rules is empty %}
        <twig:Ui:EmptyState :title="'admin.template.rule.empty'|trans" icon="zap" bordered>{{ 'automation.empty_hint'|trans }}</twig:Ui:EmptyState>
    {% endif %}

    {% for group in [{ timed: false, title: 'automation.group.event', icon: 'zap' }, { timed: true, title: 'automation.group.timed', icon: 'clock' }] %}
        {% set groupRules = rules|filter(rule => rule_is_timed(rule) == group.timed) %}
        {% if groupRules is not empty %}
            <section class="space-y-2">
                <h2 class="flex items-center gap-2 text-[11px] font-semibold uppercase tracking-wider text-muted"><twig:ux:icon name="lucide:{{ group.icon }}" class="h-3.5 w-3.5" />{{ group.title|trans }}</h2>
                <ul class="divide-y divide-line-subtle rounded-lg border border-line bg-surface">
                    {% for rule in groupRules %}
                        {% set ruleRoute = { template: template.id, rule: rule.id } %}
                        <li class="flex flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3">
                            <form method="post" action="{{ path('app_admin_template_automation_switch', ruleRoute|merge({ action: rule.active ? 'deactivate' : 'activate' })) }}" data-controller="autosubmit">
                                <input type="hidden" name="_token" value="{{ csrf_token('submit') }}" data-controller="csrf-protection">
                                <twig:Ui:Form:Toggle :label="(rule.active ? 'automation.active' : 'automation.inactive')|trans" :checked="rule.active" tone="indigo" class="w-20" data-action="change->autosubmit#submit" />
                            </form>
                            <div class="min-w-0 flex-1 basis-72 leading-snug">
                                <a href="{{ path('app_admin_template_automation', ruleRoute) }}" class="text-sm font-medium hover:text-brand {{ rule.active ? 'text-strong' : 'text-muted' }}">{{ rule.name }}</a>
                                <p class="text-xs text-muted">{{ rule_sentence(rule) }}</p>
                            </div>
                            <twig:Ui:Badge :tone="rule.tracker ? 'indigo' : 'gray'">{{ rule.tracker ? rule.tracker.name : 'automation.all_trackers'|trans }}</twig:Ui:Badge>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}
    {% endfor %}
{% endblock %}
