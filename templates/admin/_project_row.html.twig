{# A project in an administration list: its key, its name (opening it as its members see it), its state, the archive button on hover. Expects `project`. #}
<twig:Ui:Table:Row :closed="project.readOnly">
    <td class="sm:px-4 sm:py-2.5 sm:w-28 order-1 whitespace-nowrap"><twig:Ui:Chip>{{ project.issuePrefix }}</twig:Ui:Chip></td>
    <td class="sm:px-3 sm:py-2.5 order-2 basis-full sm:basis-auto">
        <a href="{{ path('app_project_issues', { workspaceKey: project.workspace.key, projectKey: project.key }) }}" class="font-medium {{ project.readOnly ? 'text-gray-500' : 'text-gray-900' }} hover:text-amber-800">{{ project.name }}</a>
        {% if project.archived %}
            <twig:Ui:Badge size="sm">{{ 'admin.project.archived_badge'|trans }}</twig:Ui:Badge>
        {% elseif project.workspace.archived %}
            <twig:Ui:Badge size="sm">{{ 'admin.workspace.archived_badge'|trans }}</twig:Ui:Badge>
        {% endif %}
    </td>
    <td class="sm:px-3 sm:py-2.5 sm:w-32 order-3 text-xs text-gray-400 whitespace-nowrap">{{ 'admin.created_on'|trans({ '%date%': project.createdAt|date('d/m/Y') }) }}</td>
    <td class="sm:px-4 sm:py-2.5 sm:w-40 order-4 ml-auto text-right whitespace-nowrap">
        <span class="hover-actions inline-flex justify-end">{{ include('admin/_project_archive.html.twig') }}</span>
    </td>
</twig:Ui:Table:Row>
