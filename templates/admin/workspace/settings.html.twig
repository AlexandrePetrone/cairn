{% extends 'admin/workspace/base.html.twig' %}

{% block workspace_content %}
    {{ form_start(form, { attr: { class: 'max-w-2xl rounded-lg border border-line bg-surface p-4 space-y-4' } }) }}
        {{ form_errors(form) }}
        {{ form_row(form.name) }}
        <p class="text-xs text-muted">{{ 'admin.workspace.key_fixed'|trans({ '%key%': workspace.key }) }}</p>
        {{ form_row(form.archived) }}
        <twig:Ui:Button type="submit" variant="primary" size="lg">{{ 'admin.save'|trans }}</twig:Ui:Button>
    {{ form_end(form) }}
{% endblock %}
