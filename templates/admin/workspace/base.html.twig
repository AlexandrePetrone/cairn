{# Base of the pages of a workspace: its name and key, its tabs (one route each). Pages fill `workspace_content`. #}
{% extends 'layout/admin.html.twig' %}

{% block page_title %}{{ workspace.name }}{% endblock %}

{% block breadcrumb %}
    <twig:ux:icon name="lucide:chevron-right" class="h-3 w-3 text-gray-300 shrink-0" />
    <a href="{{ path('app_admin_workspaces') }}" class="hover:text-gray-900">{{ 'admin.nav.workspaces'|trans }}</a>
{% endblock %}

{% block content %}
    {% set workspaceRoute = { key: workspace.key } %}
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-5 space-y-4">
        <div class="flex flex-wrap items-end gap-4">
            <div>
                <p class="text-xs text-gray-500">{{ 'admin.workspace.label'|trans }}</p>
                <h1 class="text-xl font-semibold text-gray-900 flex items-center gap-2">
                    {{ workspace.name }}
                    <twig:Ui:Chip>{{ workspace.key }}</twig:Ui:Chip>
                    {% if workspace.archived %}<twig:Ui:Badge>{{ 'admin.workspace.archived_badge'|trans }}</twig:Ui:Badge>{% endif %}
                </h1>
            </div>
            {% if not workspace.archived %}
                <twig:Ui:Button icon="plus" href="{{ path('app_admin_project_new', { workspace: workspace.key }) }}" class="ml-auto">{{ 'admin.project.new'|trans }}</twig:Ui:Button>
            {% endif %}
        </div>
        <nav class="flex items-center gap-1 border-b border-gray-200">
            <twig:Ui:Tab href="{{ path('app_admin_workspace', workspaceRoute) }}" :active="app.current_route == 'app_admin_workspace'">{{ 'admin.workspace.tab.projects'|trans }}</twig:Ui:Tab>
            <twig:Ui:Tab href="{{ path('app_admin_workspace_access', workspaceRoute) }}" :active="app.current_route == 'app_admin_workspace_access'">{{ 'admin.workspace.tab.access'|trans }}</twig:Ui:Tab>
            <twig:Ui:Tab href="{{ path('app_admin_workspace_settings', workspaceRoute) }}" icon="settings" right :active="app.current_route == 'app_admin_workspace_settings'">{{ 'admin.workspace.tab.settings'|trans }}</twig:Ui:Tab>
        </nav>
        {% block workspace_content %}{% endblock %}
    </div>
{% endblock %}
