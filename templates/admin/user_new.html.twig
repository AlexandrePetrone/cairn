{% extends 'layout/admin.html.twig' %}

{% block page_title %}{{ 'admin.user.new'|trans }}{% endblock %}

{% block breadcrumb %}
    <twig:ux:icon name="lucide:chevron-right" class="h-3 w-3 text-ghost shrink-0" />
    <a href="{{ path('app_admin_users') }}" class="hover:text-strong">{{ 'admin.nav.users'|trans }}</a>
{% endblock %}

{% block content %}
    <div class="max-w-2xl mx-auto px-4 sm:px-6 py-5 space-y-4">
        <div>
            <h1 class="text-xl font-semibold text-strong">{{ 'admin.user.new'|trans }}</h1>
            <p class="text-xs text-muted">{{ 'admin.user.new_help'|trans }}</p>
        </div>
        {{ form_start(form, { attr: { class: 'rounded-lg border border-line bg-surface p-4 space-y-4' } }) }}
            {{ form_errors(form) }}
            <div class="grid sm:grid-cols-2 gap-4">
                {{ form_row(form.firstName) }}
                {{ form_row(form.lastName) }}
            </div>
            <div class="grid sm:grid-cols-2 gap-4">
                {{ form_row(form.email) }}
                {{ form_row(form.company) }}
            </div>
            {{ form_row(form.type) }}
            {% if form.authMethod is defined %}{{ form_row(form.authMethod) }}{% endif %}
            <div class="flex items-center gap-2">
                {# With a provider to sign in through, creating does not always invite. #}
                {% if form.authMethod is defined %}
                    <twig:Ui:Button type="submit" variant="primary" size="lg">{{ 'admin.user.create'|trans }}</twig:Ui:Button>
                {% else %}
                    <twig:Ui:Button type="submit" variant="primary" size="lg" icon="send">{{ 'admin.user.create_and_invite'|trans }}</twig:Ui:Button>
                {% endif %}
                <twig:Ui:Button variant="ghost" size="lg" href="{{ path('app_admin_users') }}">{{ 'admin.cancel'|trans }}</twig:Ui:Button>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
