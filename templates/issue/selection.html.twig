{# The selection page, in the layout of where the list was: a project's (with `project`) or the application's. #}
{% extends project is defined and project ? 'layout/project.html.twig' : 'layout/app.html.twig' %}

{% block page_title %}{{ 'issue.selection.title'|trans }}{% endblock %}

{% block content %}
    <div class="border-b border-gray-200 bg-white px-4 sm:px-6 py-3 flex flex-wrap items-center gap-3">
        <h1 class="font-semibold text-gray-900 text-base">{{ 'issue.selection.title'|trans }}</h1>
        <a href="{{ back }}" class="ml-auto inline-flex items-center gap-1 text-xs text-indigo-600 hover:underline">
            <twig:ux:icon name="lucide:arrow-left" class="h-3.5 w-3.5" />{{ 'issue.selection.back'|trans }}
        </a>
    </div>
    <div class="px-4 sm:px-6 py-4">
        <twig:IssueList:Selection :issueIds="ids" :back="back" />
    </div>
{% endblock %}
