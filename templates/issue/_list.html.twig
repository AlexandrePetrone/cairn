{# The table of Issue:List and its pager. Headers sort the list (`sortBy`); the header checkbox checks the whole page. A grouped list draws a header row per group, which folds it (`toggleGroup`). `showProject` adds the project column. #}
{% if listIssues.items is empty %}
    <twig:Ui:EmptyState :title="'issue.list.empty'|trans" bordered>{{ 'issue.list.empty_hint'|trans }}</twig:Ui:EmptyState>
{% else %}
    {% set listGrouping = listComponent.group %}
    <twig:Ui:Table>
        <twig:block name="head">
            <th class="px-3 py-2 w-8">
                <input type="checkbox" aria-label="{{ 'issue.bulk.select_page'|trans }}" {{ listComponent.pageSelected ? 'checked' }} data-action="live#action" data-live-action-param="togglePage" class="h-3.5 w-3.5 rounded border-gray-300 text-indigo-600">
            </th>
            {% for listColumn in ['key', 'project', 'title', 'tracker', 'place', 'criticality', 'assignee', 'updated'] %}
                {% if listColumn != 'project' or showProject %}
                    <twig:Ui:Table:SortHeader
                        :direction="listComponent.sortDirection(listColumn)"
                        :align="listColumn == 'updated' ? 'right' : 'left'"
                        class="{{ { key: 'w-32', project: 'w-44', title: '', tracker: 'w-32', place: 'w-44', criticality: 'w-28', assignee: 'w-12', updated: 'w-28' }[listColumn] }}"
                        data-action="live#action" data-live-action-param="sortBy" data-live-column-param="{{ listColumn }}"
                    >{{ ('issue.list.column.' ~ listColumn)|trans }}</twig:Ui:Table:SortHeader>
                {% endif %}
            {% endfor %}
        </twig:block>
        {% if listGrouping %}
            {% for listGroup in listComponent.groups %}
                {% set groupIssue = listGroup.first %}
                <twig:Ui:Table:GroupRow :count="listGroup.total" :collapsed="listGroup.collapsed" :colspan="showProject ? 9 : 8"
                    data-action="live#action" data-live-action-param="toggleGroup" data-live-key-param="{{ listGroup.key }}"
                    title="{{ (listGroup.collapsed ? 'issue.list.group.expand' : 'issue.list.group.collapse')|trans }}">
                    {% if listGrouping == 'place' %}
                        <twig:Ui:Status:Step :status="groupIssue.status.value" :label="listComponent.placeLabel(listGroup.key)" />
                    {% elseif listGrouping == 'criticality' %}
                        <twig:Ui:Criticality:Badge :criticality="groupIssue.criticality.value" />
                    {% elseif listGrouping == 'assignee' %}
                        <span class="inline-flex items-center gap-2">
                            <twig:Ui:Avatar :name="groupIssue.assignee ? groupIssue.assignee.fullName : null" :kind="groupIssue.assignee and groupIssue.assignee.internal ? 'internal' : 'external'" size="xs" />
                            {{ groupIssue.assignee ? groupIssue.assignee.fullName : 'issue.unassigned'|trans }}
                        </span>
                    {% elseif listGrouping == 'release' %}
                        <span class="font-mono">{{ listComponent.releaseLabel(listGroup.key) ?? 'issue.list.no_release'|trans }}</span>
                    {% else %}
                        <span>{{ groupIssue.project.name }} <span class="font-normal text-gray-400">· {{ groupIssue.project.workspace.name }}</span></span>
                    {% endif %}
                </twig:Ui:Table:GroupRow>
                {% if not listGroup.collapsed %}
                    {% for issue in listGroup.issues %}{{ include('issue/_list_row.html.twig') }}{% endfor %}
                {% endif %}
            {% endfor %}
        {% else %}
            {% for issue in listIssues.items %}{{ include('issue/_list_row.html.twig') }}{% endfor %}
        {% endif %}
    </twig:Ui:Table>
{% endif %}

{% if listIssues.pageCount > 1 %}
    <nav class="flex items-center justify-between text-xs text-gray-500" aria-label="{{ 'pagination.label'|trans }}">
        <span>{{ 'pagination.page_of'|trans({ '%page%': listIssues.page, '%count%': listIssues.pageCount }) }}</span>
        <div class="flex items-center gap-2">
            {% if listIssues.page > 1 %}
                <twig:Ui:Button size="sm" data-action="live#action" data-live-action-param="turnPage" data-live-page-param="{{ listIssues.page - 1 }}">{{ 'pagination.previous'|trans }}</twig:Ui:Button>
            {% endif %}
            {% if listIssues.page < listIssues.pageCount %}
                <twig:Ui:Button size="sm" data-action="live#action" data-live-action-param="turnPage" data-live-page-param="{{ listIssues.page + 1 }}">{{ 'pagination.next'|trans }}</twig:Ui:Button>
            {% endif %}
        </div>
    </nav>
{% endif %}
