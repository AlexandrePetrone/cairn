{# Base of the administration pages (`/admin/…`): the header in its administration variant, the administration navigation, a breadcrumb rooted on the administration.
   Pages fill `page_title` and `content`; `breadcrumb` lists the steps between the root and the title, as links. The blocks are captured before the shell component, whose own blocks would otherwise hide them. #}
{% extends 'base.html.twig' %}

{% block title %}{{ block('page_title') }} · {{ 'admin.title'|trans }} · Cairn{% endblock %}

{% block body %}
    {% set layoutPageTitle %}{% block page_title %}{% endblock %}{% endset %}
    {% set layoutBreadcrumb %}{% block breadcrumb %}{% endblock %}{% endset %}
    {% set layoutPageContent %}{% block content %}{% endblock %}{% endset %}
    <twig:Ui:Layout:Shell>
        <twig:block name="header"><twig:Layout:Header admin /></twig:block>
        <twig:block name="sidebar"><twig:Layout:AdminNav /></twig:block>
        <twig:block name="breadcrumb">
            <nav class="flex items-center gap-1.5 px-4 sm:px-6 h-10 text-xs text-gray-500 border-b border-gray-200 bg-white/60" aria-label="{{ 'nav.breadcrumb'|trans }}">
                <a href="{{ path('app_admin') }}" class="text-amber-700 hover:text-gray-900">{{ 'admin.title'|trans }}</a>
                {{ layoutBreadcrumb }}
                <twig:ux:icon name="lucide:chevron-right" class="h-3 w-3 text-gray-300 shrink-0" />
                <span class="text-gray-900 font-medium truncate">{{ layoutPageTitle }}</span>
            </nav>
        </twig:block>
        {{ layoutPageContent }}
    </twig:Ui:Layout:Shell>
{% endblock %}
