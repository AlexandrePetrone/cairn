{# Base of the administration pages (`/admin/…`): the header in its administration variant, the administration navigation, a breadcrumb rooted on the administration.
   Pages fill `page_title` and `content`; `breadcrumb` lists the steps between the root and the title, as links. `modal` is the `modal` Turbo frame, empty unless the page fills it with its dialog (`project/_form_dialog.html.twig`): a request made for the frame is answered with this block alone (`Controller/OpensDialog`). The blocks are captured before the shell component, whose own blocks would otherwise hide them. #}
{% extends 'base.html.twig' %}

{% block title %}{{ block('page_title') }} · {{ 'admin.title'|trans }} · Cairn{% endblock %}

{% block body %}
    {% set layoutPageTitle %}{% block page_title %}{% endblock %}{% endset %}
    {% set layoutBreadcrumb %}{% block breadcrumb %}{% endblock %}{% endset %}
    {% set layoutPageContent %}{% block content %}{% endblock %}{% endset %}
    {% set layoutModal %}{% block modal %}{{ include('project/_form_dialog.html.twig', { form: null }) }}{% endblock %}{% endset %}
    <twig:Ui:Layout:Shell>
        <twig:block name="header"><twig:Layout:Header admin /></twig:block>
        <twig:block name="sidebar"><twig:Layout:AdminNav /></twig:block>
        <twig:block name="breadcrumb">
            <nav class="flex items-center gap-1.5 px-4 sm:px-6 h-10 text-xs text-muted border-b border-line bg-surface/60" aria-label="{{ 'nav.breadcrumb'|trans }}">
                <a href="{{ path('app_admin') }}" class="text-amber hover:text-strong">{{ 'admin.title'|trans }}</a>
                {{ layoutBreadcrumb }}
                <twig:ux:icon name="lucide:chevron-right" class="h-3 w-3 text-ghost shrink-0" />
                <span class="text-strong font-medium truncate">{{ layoutPageTitle }}</span>
            </nav>
        </twig:block>
        {{ layoutPageContent }}
        {{ layoutModal }}
    </twig:Ui:Layout:Shell>
{% endblock %}
