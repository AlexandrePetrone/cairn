{% extends 'layout/project.html.twig' %}

{% block page_title %}{{ release.name }} · {{ 'release.title'|trans }}{% endblock %}

{# A release of the project, for those who manage releases: its name, date and description, and abandoning it. Its issues stay in it whatever its status. #}
{% block content %}
    <div class="max-w-2xl px-4 sm:px-6 py-5 space-y-4">
        <div>
            <a href="{{ path('app_project_releases', { workspaceKey: project.workspace.key, projectKey: project.key }) }}" class="text-xs text-gray-500 hover:text-indigo-600">← {{ 'release.title'|trans }}</a>
            <h1 class="mt-1 font-mono text-xl font-semibold text-gray-900">{{ release.name }}</h1>
        </div>
        {{ form_start(form, { attr: { class: 'rounded-lg border border-gray-200 bg-white p-4 space-y-4' } }) }}
            {{ form_errors(form) }}
            {{ form_row(form.name) }}
            {{ form_row(form.plannedOn) }}
            {{ form_row(form.description) }}
            <twig:Ui:Button type="submit" variant="primary" size="lg">{{ 'release.save'|trans }}</twig:Ui:Button>
        {{ form_end(form) }}
        {% if release.open %}
            <twig:Ui:Callout tone="danger" class="rounded-lg p-4 flex flex-wrap items-center gap-3">
                <p class="flex-1 text-sm">{{ 'release.abandon_help'|trans }}</p>
                {{ include('project/_release_status.html.twig', { status: 'abandoned', variant: 'danger' }) }}
            </twig:Ui:Callout>
        {% endif %}
    </div>
{% endblock %}
