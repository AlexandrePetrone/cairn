{% extends 'layout/project.html.twig' %}

{% set issue = detail.issue %}

{% block page_title %}{{ issue.key }}{% endblock %}

{% block content %}
    <div class="px-4 sm:px-6 py-5 max-w-screen-2xl lg:flex lg:gap-8">
        <div class="flex-1 min-w-0">
            <twig:Issue:Header :issue="issue" />
            {# Siblings, not nested: a live component's redraw must not touch another one. #}
            <section class="mt-5 rounded-lg border border-gray-200 bg-white p-3 text-gray-800 leading-relaxed">
                <twig:Issue:Description :issue="issue" />
                <twig:Issue:Files :issue="issue" />
            </section>
            <twig:Issue:Activity :issue="issue" />
        </div>

        <aside class="mt-8 lg:mt-0 lg:w-72 shrink-0">
            <div class="lg:sticky lg:top-16 rounded-lg border border-gray-200 bg-white divide-y divide-gray-100">
                <twig:Issue:Properties :issue="issue" />
                <twig:Issue:Fields :issue="issue" />
                <twig:Issue:Links :issue="issue" />
            </div>
        </aside>
    </div>
{% endblock %}
