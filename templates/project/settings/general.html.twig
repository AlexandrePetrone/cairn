{% extends 'project/settings/base.html.twig' %}

{% block settings_content %}
    {{ form_start(form, { attr: { class: 'max-w-2xl rounded-lg border border-line bg-surface p-4 space-y-4' } }) }}
        {{ form_errors(form) }}
        {{ form_row(form.name) }}
        <p class="text-xs text-muted">{{ 'project.settings.key_fixed'|trans({ '%key%': project.issuePrefix }) }}</p>
        {{ form_row(form.description) }}
        <twig:Ui:Button type="submit" variant="primary" size="lg">{{ 'project.settings.save'|trans }}</twig:Ui:Button>
    {{ form_end(form) }}
{% endblock %}
