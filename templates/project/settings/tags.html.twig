{% extends 'project/settings/base.html.twig' %}

{# The tags of the project, by name, each with the issues that carry it and the list they make; `form`, at its own address, is the dialog creating one or changing `dialogTag`, where it is deleted too. #}
{% block settings_title %}{{ 'nav.project.configuration.tags'|trans }}{% endblock %}

{% block settings_count %}{{ tags|length }}{% endblock %}

{% block settings_intro %}{{ 'tag.intro'|trans }}{% endblock %}

{% block settings_actions %}
    <twig:Ui:Button variant="primary" icon="plus" href="{{ path('app_project_settings_tag_new', settingsRoute) }}" data-turbo-frame="modal">{{ 'tag.new'|trans }}</twig:Ui:Button>
{% endblock %}

{% block settings_content %}
    <div class="max-w-3xl">
        {% if tags is empty %}
            <twig:Ui:EmptyState :title="'tag.empty'|trans" icon="tags" bordered>{{ 'tag.empty_hint'|trans }}</twig:Ui:EmptyState>
        {% else %}
            <ul class="divide-y divide-line-subtle rounded-lg border border-line bg-surface text-sm">
                {% for tag in tags %}
                    {% set tagsIssueCount = issueCounts[tag.id] ?? 0 %}
                    <li class="group flex items-center gap-3 px-4 py-2.5">
                        <twig:Ui:Tag :colour="tag.colour.value">{{ tag.name }}</twig:Ui:Tag>
                        <a href="{{ path('app_project_issues', settingsRoute|merge({ tags: [tag.id], closed: 1 })) }}" class="ml-auto text-xs text-muted hover:text-brand hover:underline">{{ 'issue.list.count'|trans({ '%count%': tagsIssueCount }) }}</a>
                        <twig:Ui:IconButton icon="pencil" :label="'tag.edit'|trans({ '%name%': tag.name })" href="{{ path('app_project_settings_tag', settingsRoute|merge({ tag: tag.id })) }}" data-turbo-frame="modal" />
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
{% endblock %}

{# Answered alone to a request made for the frame: it reads only `project`, `form`, `dialogTag` and `dialogIssueCount`. The colours are drawn as the tags they make, each a radio button; the form deleting the tag sits beside the one of the dialog, in the frame: its button names it. #}
{% block modal %}
    {% set modalRoute = { workspaceKey: project.workspace.key, projectKey: project.key } %}
    {% set modalFields = '' %}
    {% set modalDeleteForm = '' %}
    {% set modalDelete = '' %}
    {% if form %}
        {% set modalFields %}
            {{ form_row(form.name) }}
            <fieldset>
                <legend class="block text-sm font-medium text-body">{{ form.colour.vars.label|trans }}</legend>
                <div class="mt-1.5 flex flex-wrap gap-1.5">
                    {% for choice in form.colour %}
                        <label class="cursor-pointer">
                            <input type="radio" id="{{ choice.vars.id }}" name="{{ choice.vars.full_name }}" value="{{ choice.vars.value }}" class="peer sr-only" required {{ choice.vars.checked ? 'checked' }}>
                            <twig:Ui:Tag :colour="choice.vars.value" class="peer-checked:bg-brand-soft peer-checked:ring-2 peer-checked:ring-brand peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-focus">{{ choice.vars.label|trans }}</twig:Ui:Tag>
                        </label>
                        {% do choice.setRendered %}
                    {% endfor %}
                </div>
                {{ form_errors(form.colour) }}
                {% do form.colour.setRendered %}
            </fieldset>
        {% endset %}
        {% if dialogTag %}
            {% set modalDeleteForm %}
                <form id="tag-delete" method="post" action="{{ path('app_project_settings_tag_delete', modalRoute|merge({ tag: dialogTag.id })) }}" class="hidden">
                    <input type="hidden" name="_token" value="{{ csrf_token('submit') }}" data-controller="csrf-protection">
                </form>
            {% endset %}
            {% set modalDelete %}
                <twig:Ui:Callout tone="danger" size="sm" class="mt-4">
                    <p>{{ 'tag.delete_help'|trans({ '%count%': dialogIssueCount }) }}</p>
                    <twig:Ui:Disclosure :closedLabel="'tag.delete'|trans" :openLabel="'issue.edit.cancel'|trans" class="mt-1.5">
                        <div class="mt-2 flex flex-wrap items-center gap-3" role="alertdialog">
                            <span class="flex-1 basis-48">{{ 'tag.delete_confirm'|trans }}</span>
                            <twig:Ui:Button type="submit" variant="danger" size="sm" icon="trash-2" form="tag-delete">{{ 'tag.delete'|trans }}</twig:Ui:Button>
                        </div>
                    </twig:Ui:Disclosure>
                </twig:Ui:Callout>
            {% endset %}
        {% endif %}
    {% endif %}
    {{ include('project/_form_dialog.html.twig', {
        title: dialogTag ? dialogTag.name : 'tag.new'|trans,
        closeHref: path('app_project_settings_tags', modalRoute),
        submitLabel: (dialogTag ? 'tag.save' : 'tag.create')|trans,
        fields: modalFields,
        before: modalDeleteForm,
        after: modalDelete,
    }) }}
{% endblock %}
