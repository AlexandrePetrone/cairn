{% extends 'project/settings/base.html.twig' %}

{# The editor of one automation rule, a new one without `rule`: the live component does the writing. The breadcrumb leads back to the rules. #}
{% block page_section %}{{ 'nav.project.configuration.title'|trans }} <twig:ux:icon name="lucide:chevron-right" class="mx-0.5 inline h-3 w-3 text-ghost" /> <a href="{{ path('app_project_settings_automations', { workspaceKey: project.workspace.key, projectKey: project.key }) }}" class="hover:text-strong">{{ 'automation.title'|trans }}</a>{% endblock %}

{% block settings_title %}{{ rule ? rule.name : 'automation.new_title'|trans }}{% endblock %}

{% block settings_content %}
    <twig:Automation:RuleForm :project="project" :rule="rule" />
{% endblock %}
