{% extends 'project/settings/base.html.twig' %}

{# The editor of one automation rule, a new one without `rule`: the live component does the writing. #}
{% block settings_title %}{{ (rule ? 'automation.edit_title' : 'automation.new_title')|trans }}{% endblock %}

{% block settings_content %}
    <p class="text-xs text-muted">
        <a href="{{ path('app_project_settings_automations', settingsRoute) }}" class="text-brand hover:underline">{{ 'automation.title'|trans }}</a>
        <twig:ux:icon name="lucide:chevron-right" class="inline h-3 w-3 text-ghost" />
        {{ rule ? rule.name : 'automation.new_title'|trans }}
    </p>
    <twig:Automation:RuleForm :project="project" :rule="rule" />
{% endblock %}
