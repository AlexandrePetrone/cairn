{# The two pages of the automations of a project, in the band of the page: its rules, and what they did. The same on both, so that going from one to the other moves nothing. #}
<twig:Ui:Tab href="{{ path('app_project_settings_automations', settingsRoute) }}" :active="app.current_route == 'app_project_settings_automations'">{{ 'automation.tab.rules'|trans }}</twig:Ui:Tab>
<twig:Ui:Tab href="{{ path('app_project_settings_automation_runs', settingsRoute) }}" :active="app.current_route == 'app_project_settings_automation_runs'">{{ 'automation.tab.runs'|trans }}</twig:Ui:Tab>
