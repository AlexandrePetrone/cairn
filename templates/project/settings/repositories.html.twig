{% extends 'project/settings/base.html.twig' %}

{# The repositories of the forges linked to the project, with their webhook installed or not, and the form linking one more. A repository waiting for its webhook shows what to paste on the forge; unlinking confirms in place. #}
{% block settings_content %}
    <p class="text-sm text-muted max-w-3xl">{{ 'project.settings.repository.intro'|trans({ '%prefix%': project.issuePrefix }) }}</p>
    <div class="grid gap-5 items-start lg:grid-cols-[1fr_20rem]">
        <div class="space-y-3 min-w-0">
            {% for repository in repositories %}
                <section class="rounded-lg border border-line bg-surface px-4 py-3">
                    <div class="flex flex-wrap items-center gap-2">
                        <twig:ux:icon name="lucide:git-branch" class="h-4 w-4 text-faint" />
                        <twig:Ui:Badge tone="gray" size="sm">{{ repository.forge.label|trans }}</twig:Ui:Badge>
                        <code class="font-mono text-sm font-medium text-strong">{{ repository.path }}</code>
                        {% if repository.installed %}
                            <twig:Ui:Badge tone="emerald" size="sm" icon="check">{{ 'project.settings.repository.installed'|trans({ '%date%': repository.installedAt|date('d/m/Y') }) }}</twig:Ui:Badge>
                        {% else %}
                            <twig:Ui:Badge tone="amber" size="sm" icon="circle-alert">{{ 'project.settings.repository.not_installed'|trans }}</twig:Ui:Badge>
                        {% endif %}
                        <div class="ml-auto flex flex-wrap items-center gap-2">
                            {% if repository.installed %}
                                {{ include('project/settings/_repository_action.html.twig', { action: 'uninstall' }) }}
                            {% elseif canInstall %}
                                {{ include('project/settings/_repository_action.html.twig', { action: 'install', variant: 'primary' }) }}
                            {% endif %}
                            {{ include('project/settings/_repository_action.html.twig', { action: 'secret', variant: 'ghost' }) }}
                        </div>
                    </div>
                    {% if not repository.installed %}
                        <twig:Ui:Callout tone="blue" class="mt-3">
                            <p class="font-medium">{{ 'project.settings.repository.manual.title'|trans }}</p>
                            <p class="mt-1 text-xs">{{ 'project.settings.repository.manual.intro'|trans }}</p>
                            <dl class="mt-2 grid gap-x-4 gap-y-1 text-xs sm:grid-cols-[auto_1fr]">
                                <dt class="text-blue">{{ 'project.settings.repository.manual.url'|trans }}</dt>
                                <dd><code class="select-all break-all font-mono text-strong">{{ webhookUrl }}</code></dd>
                                <dt class="text-blue">{{ 'project.settings.repository.manual.secret'|trans }}</dt>
                                <dd><code class="select-all break-all font-mono text-strong">{{ repository.secret }}</code></dd>
                                <dt class="text-blue">{{ 'project.settings.repository.manual.events'|trans }}</dt>
                                <dd>{{ 'project.settings.repository.manual.events_value'|trans }}</dd>
                            </dl>
                            <p class="mt-2 text-xs">{{ 'project.settings.repository.manual.warning'|trans }}</p>
                        </twig:Ui:Callout>
                    {% endif %}
                    <twig:Ui:Disclosure :closedLabel="'project.settings.repository.action.unlink'|trans" :openLabel="'issue.edit.cancel'|trans" class="mt-3">
                        <twig:Ui:Callout tone="danger" size="sm" class="mt-2 flex flex-wrap items-center gap-2" role="alertdialog">
                            <span class="flex-1">{{ 'project.settings.repository.unlink_confirm'|trans }}</span>
                            {{ include('project/settings/_repository_action.html.twig', { action: 'unlink', variant: 'danger', icon: 'trash-2' }) }}
                        </twig:Ui:Callout>
                    </twig:Ui:Disclosure>
                </section>
            {% else %}
                <twig:Ui:EmptyState :title="'project.settings.repository.empty'|trans" icon="git-branch" bordered>{{ 'project.settings.repository.empty_hint'|trans }}</twig:Ui:EmptyState>
            {% endfor %}
        </div>

        {{ form_start(form, { attr: { class: 'rounded-lg border border-line bg-surface p-4 space-y-4' } }) }}
            <h2 class="font-semibold text-strong">{{ 'project.settings.repository.new'|trans }}</h2>
            {{ form_errors(form) }}
            {{ form_row(form.forge) }}
            {{ form_row(form.path) }}
            <twig:Ui:Button type="submit" variant="primary" size="lg" icon="plus">{{ 'project.settings.repository.link'|trans }}</twig:Ui:Button>
            <p class="text-xs text-muted">{{ (canInstall ? 'project.settings.repository.link_help_api' : 'project.settings.repository.link_help')|trans }}</p>
        {{ form_end(form) }}
    </div>
{% endblock %}
