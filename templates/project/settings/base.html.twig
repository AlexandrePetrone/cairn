{# Base of the configuration pages of a project, one per item of the navigation's Configuration section: the title of the subject (`settings_title`), then the page (`settings_content`). #}
{% extends 'layout/project.html.twig' %}

{% block page_title %}{{ block('settings_title') }}{% endblock %}

{% block content %}
    {% set settingsRoute = { workspaceKey: project.workspace.key, projectKey: project.key } %}
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-5 space-y-4">
        <div>
            <h1 class="text-xl font-semibold text-strong">{% block settings_title %}{{ 'project.settings.title'|trans }}{% endblock %}</h1>
            <p class="text-xs text-muted">{{ 'project.settings.subtitle'|trans({ '%project%': project.name, '%workspace%': project.workspace.name }) }}</p>
        </div>
        {% block settings_content %}{% endblock %}
    </div>
{% endblock %}
