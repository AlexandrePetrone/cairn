{% extends 'project/settings/base.html.twig' %}

{% block settings_title %}{{ 'nav.project.configuration.trackers'|trans }}{% endblock %}

{% block settings_content %}
    <div class="grid gap-4 lg:grid-cols-[20rem_1fr] items-start">
        <twig:Tracker:Order :project="project" />
        {{ form_start(form, { attr: { class: 'rounded-lg border border-line bg-surface p-4 space-y-4' } }) }}
            <h2 class="font-semibold text-strong">{{ 'project.settings.tracker.new_title'|trans }}</h2>
            {{ form_errors(form) }}
            {{ form_row(form.name) }}
            {{ form_row(form.description) }}
            {{ form_row(form.workflowId) }}
            {{ form_row(form.private) }}
            <twig:Ui:Button type="submit" variant="primary" size="lg" icon="plus">{{ 'project.settings.tracker.create'|trans }}</twig:Ui:Button>
        {{ form_end(form) }}
    </div>
{% endblock %}
