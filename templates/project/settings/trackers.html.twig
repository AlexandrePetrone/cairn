{% extends 'project/settings/base.html.twig' %}

{# The trackers of the project in their order, while it has none to show the page of; `form`, at its own address, is the dialog creating one. #}
{% block settings_title %}{{ 'nav.project.configuration.trackers'|trans }}{% endblock %}

{% block settings_actions %}
    <twig:Ui:Button variant="primary" icon="plus" href="{{ path('app_project_settings_tracker_new', settingsRoute) }}" data-turbo-frame="modal">{{ 'project.settings.tracker.new_title'|trans }}</twig:Ui:Button>
{% endblock %}

{% block settings_content %}
    <twig:Tracker:Order :project="project" class="block max-w-3xl" />
{% endblock %}

{# Answered alone to a request made for the frame: it reads only `project` and `form`. #}
{% block modal %}
    {{ include('project/_form_dialog.html.twig', {
        title: 'project.settings.tracker.new_title'|trans,
        closeHref: path('app_project_settings', { workspaceKey: project.workspace.key, projectKey: project.key }),
        submitLabel: 'project.settings.tracker.create'|trans,
    }) }}
{% endblock %}
