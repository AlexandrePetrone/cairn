{% extends 'project/settings/base.html.twig' %}

{% block settings_title %}{{ 'nav.project.configuration.trackers'|trans }}{% endblock %}

{% block settings_content %}
    <div class="grid gap-4 lg:grid-cols-[20rem_1fr] items-start">
        <twig:Tracker:Order :project="project" :current="tracker.id" />
        <div class="space-y-4 min-w-0">
            {{ form_start(form, { attr: { class: 'rounded-lg border border-line bg-surface p-4 space-y-4' } }) }}
                <h2 class="font-semibold text-strong">{{ tracker.name }}</h2>
                {{ form_errors(form) }}
                {{ form_row(form.name) }}
                {{ form_row(form.description) }}
                {{ form_row(form.private) }}
                {{ form_row(form.active) }}
                <twig:Ui:Button type="submit" variant="primary" size="lg">{{ 'project.settings.save'|trans }}</twig:Ui:Button>
            {{ form_end(form) }}
            <section class="rounded-lg border border-line bg-surface p-4 space-y-3">
                <div>
                    <h2 class="font-semibold text-strong">{{ 'project.settings.tracker.workflow'|trans }} · {{ workflow ? workflow.label : tracker.workflowId }}</h2>
                    <p class="text-xs text-muted">{{ 'project.settings.tracker.workflow_fixed'|trans }}</p>
                </div>
                {% if workflow %}
                    <twig:Workflow:Diagram :workflow="workflow" />
                {% endif %}
            </section>
        </div>
    </div>
{% endblock %}
