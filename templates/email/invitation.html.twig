{# An account was created for the recipient: one link to choose their password, valid `days` days. #}
{% extends 'email/_layout.html.twig' %}

{% block title %}{{ 'email.invitation.subject'|trans }}{% endblock %}

{% block body %}
    <h1 style="margin:0 0 12px;font-size:18px;line-height:1.3;">{{ 'email.invitation.greeting'|trans({ '%name%': user.firstName }) }}</h1>
    <p style="margin:0 0 16px;color:#374151;">{{ 'email.invitation.text'|trans }}</p>
    <p style="margin:0 0 16px;">
        <a href="{{ url }}" style="display:inline-block;padding:8px 14px;background:#4f46e5;color:#ffffff;text-decoration:none;border-radius:6px;font-size:14px;font-weight:500;">{{ 'email.invitation.button'|trans }}</a>
    </p>
    <p style="margin:0;font-size:13px;color:#6b7280;">{{ 'email.invitation.validity'|trans({ '%days%': days }) }}</p>
{% endblock %}

{% block footer %}{{ 'email.invitation.footer'|trans({ '%email%': user.email }) }}{% endblock %}
